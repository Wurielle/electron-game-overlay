{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "node-game-overlay",
  "projectType": "library",
  "sourceRoot": "libs/node-game-overlay/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/build_x64", "{projectRoot}/node-game-overlay.node"],
      "options": {
        "command": "cmake-js -G \"Visual Studio 17 2022\" -A x64 -a x64 -O build_x64"
      }
    },
    "build-x86": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/build_Win32", "{projectRoot}/node-game-overlay.node"],
      "options": {
        "command": "cmake-js -G \"Visual Studio 17 2022\" -A Win32 -a ia32 -O build_Win32"
      }
    },
    "build-x64": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/build_x64", "{projectRoot}/node-game-overlay.node"],
      "options": {
        "command": "cmake-js -G \"Visual Studio 17 2022\" -A x64 -a x64 -O build_x64"
      }
    }
  }
}
