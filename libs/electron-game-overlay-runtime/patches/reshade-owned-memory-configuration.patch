+
+bool reshade::ini_file::reserve_memory_cache(const std::filesystem::path &path, std::string_view bytes)
+{
+	if (!path.is_absolute() || bytes.find('\0') != std::string_view::npos)
+		return false;
+
+	const std::unique_lock<std::shared_mutex> lock(s_ini_cache_mutex);
+	if (s_ini_cache.find(path) != s_ini_cache.end())
+		return false;
+	s_ini_cache.emplace(path, std::unique_ptr<ini_file>(new ini_file(path, bytes)));
+	return true;
+}
+
+bool reshade::ini_file::has_memory_cache(const std::filesystem::path &path)
+{
+	const std::shared_lock<std::shared_mutex> lock(s_ini_cache_mutex);
+	const auto it = s_ini_cache.find(path);
+	return it != s_ini_cache.end() && it->second->_memory_backed;
+}
+
+bool reshade::ini_file::retire_memory_cache(const std::filesystem::path &path)
+{
+	const std::unique_lock<std::shared_mutex> lock(s_ini_cache_mutex);
+	const auto it = s_ini_cache.find(path);
+	if (it == s_ini_cache.end() || !it->second->_memory_backed)
+		return false;
+	s_ini_cache.erase(it);
+	return true;
 }
 
