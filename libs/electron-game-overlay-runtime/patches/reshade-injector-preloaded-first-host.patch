+// The text is already decoded from a bounded UTF-8 regular file. Keep this
+// grammar aligned with the native participant's five-field ownership record.
+static bool valid_owned_run_marker(const std::wstring &document, const std::wstring &stage_leaf)
+{
+    if (stage_leaf.empty()) return false;
+    size_t position = 0;
+    const auto whitespace = [&]() {
+        while (position < document.size() &&
+            (document[position] == L' ' || document[position] == L'\t' ||
+             document[position] == L'\r' || document[position] == L'\n'))
+            ++position;
+    };
+    const auto string_value = [&](std::wstring &value) {
+        whitespace();
+        value.clear();
+        if (position == document.size() || document[position++] != L'"') return false;
+        while (position < document.size())
+        {
+            const wchar_t character = document[position++];
+            if (character == L'"') return true;
+            if (character < 0x20) return false;
+            if (character == L'\\')
+            {
+                if (position == document.size()) return false;
+                const wchar_t escaped = document[position++];
+                if (escaped == L'"' || escaped == L'\\' || escaped == L'/') value += escaped;
+                else return false;
+            }
+            else value += character;
+        }
+        return false;
+    };
+    whitespace();
+    if (position == document.size() || document[position++] != L'{') return false;
+    std::unordered_map<std::wstring, std::wstring> fields;
+    for (;;)
+    {
+        std::wstring key, value;
+        if (!string_value(key)) return false;
+        if (key != L"schemaVersion" && key != L"kind" && key != L"runId" &&
+            key != L"directoryName" && key != L"createdAt") return false;
+        whitespace();
+        if (position == document.size() || document[position++] != L':') return false;
+        whitespace();
+        if (key == L"schemaVersion")
+        {
+            if (position == document.size() || document[position++] != L'1') return false;
+            value = L"1";
+        }
+        else if (!string_value(value)) return false;
+        if (!fields.emplace(key, value).second) return false;
+        whitespace();
+        if (position == document.size()) return false;
+        const wchar_t separator = document[position++];
+        if (separator == L'}') break;
+        if (separator != L',') return false;
+    }
+    whitespace();
+    if (position != document.size() || fields.size() != 5 ||
+        fields[L"schemaVersion"] != L"1" ||
+        fields[L"kind"] != L"electron-game-overlay-reshade-run" ||
+        fields[L"directoryName"] != stage_leaf) return false;
+    const auto &id = fields[L"runId"];
+    if (id.size() != 36 || id[14] != L'4' ||
+        (id[19] != L'8' && id[19] != L'9' && id[19] != L'a' && id[19] != L'b')) return false;
+    for (size_t index = 0; index != id.size(); ++index)
+    {
+        if (index == 8 || index == 13 || index == 18 || index == 23)
+        {
+            if (id[index] != L'-') return false;
+        }
+        else if (!((id[index] >= L'0' && id[index] <= L'9') ||
+                   (id[index] >= L'a' && id[index] <= L'f'))) return false;
+    }
+    const auto &created = fields[L"createdAt"];
+    if (created.size() != 24 || created[4] != L'-' || created[7] != L'-' || created[10] != L'T' ||
+        created[13] != L':' || created[16] != L':' || created[19] != L'.' || created[23] != L'Z') return false;
+    for (size_t index = 0; index != created.size(); ++index)
+        if (index != 4 && index != 7 && index != 10 && index != 13 && index != 16 && index != 19 && index != 23 &&
+            (created[index] < L'0' || created[index] > L'9')) return false;
+    return true;
+}
