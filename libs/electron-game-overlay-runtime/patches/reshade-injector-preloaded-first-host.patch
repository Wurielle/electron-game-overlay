+struct owned_preload_snapshot_guard
+{
+	scoped_handle stage_directory;
+	scoped_handle snapshot_directory;
+	scoped_handle addon_file;
+};
+
+static DWORD pin_owned_preload_directory(const std::wstring &path, scoped_handle &guard)
+{
+	guard.handle = CreateFileW(make_extended_length_path(path).c_str(),
+		FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+		FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+	if (guard == INVALID_HANDLE_VALUE) return GetLastError();
+	BY_HANDLE_FILE_INFORMATION info{};
+	if (!GetFileInformationByHandle(guard, &info)) return GetLastError();
+	if ((info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0) return ERROR_DIRECTORY;
+	if ((info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0) return ERROR_CANT_ACCESS_FILE;
+	std::wstring final_path;
+	DWORD error = ERROR_SUCCESS;
+	if (!get_final_directory_path(path, final_path, error)) return error;
+	return _wcsicmp(path.c_str(), final_path.c_str()) == 0 ? ERROR_SUCCESS : ERROR_CANT_ACCESS_FILE;
+}
+
+static DWORD validate_first_host_preload_snapshot(const std::wstring &stage,
+	const std::wstring &target_image, const std::wstring &runtime_path,
+	const target_effective_reshade_settings &settings, const std::wstring &leaf,
+	const BYTE (&expected_hash)[32], std::wstring &selected_path, owned_preload_snapshot_guard &guard)
+{
+	if (!valid_preloaded_addon_leaf(leaf) || !is_absolute_windows_path(stage)) return ERROR_INVALID_NAME;
+	DWORD error = ERROR_SUCCESS;
+	std::wstring full_stage;
+	if (!get_full_path(stage, full_stage, error)) return error;
+	if (_wcsicmp(stage.c_str(), full_stage.c_str()) != 0) return ERROR_BAD_PATHNAME;
+	const std::wstring snapshot = stage + L"\\preloaded-addons";
+	const std::wstring expected_runtime = stage + L"\\" + target_reshade_runtime_file;
+	if (_wcsicmp(runtime_path.c_str(), expected_runtime.c_str()) != 0 ||
+		_wcsicmp(settings.reshade_base_path.c_str(), stage.c_str()) != 0 ||
+		_wcsicmp(settings.addon_directory_path.c_str(), snapshot.c_str()) != 0)
+		return ERROR_ACCESS_DENIED;
+	error = pin_owned_preload_directory(stage, guard.stage_directory);
+	if (error != ERROR_SUCCESS) return error;
+	error = pin_owned_preload_directory(snapshot, guard.snapshot_directory);
+	if (error != ERROR_SUCCESS) return error;
+	const size_t target_separator = target_image.find_last_of(L"\\/");
+	std::wstring target_directory;
+	if (target_separator == std::wstring::npos ||
+		!get_final_directory_path(target_image.substr(0, target_separator), target_directory, error))
+		return error != ERROR_SUCCESS ? error : ERROR_BAD_PATHNAME;
+	if (path_is_same_or_descendant(target_directory, stage)) return ERROR_ACCESS_DENIED;
+
+	bool missing = false;
+	std::vector<BYTE> bytes;
+	constexpr char owned_marker[] = "ELECTRON_GAME_OVERLAY_OWNED_RUNTIME_STAGE_V1\n";
+	if (!read_bounded_regular_file(stage + L"\\electron-game-overlay-owned-runtime-v1.marker",
+		4096, bytes, missing, error)) return error;
+	if (missing || bytes.size() != sizeof(owned_marker) - 1 ||
+		memcmp(bytes.data(), owned_marker, sizeof(owned_marker) - 1) != 0) return ERROR_INVALID_DATA;
+	if (!read_bounded_regular_file(stage + L"\\.electron-game-overlay-run.json",
+		4096, bytes, missing, error)) return error;
+	if (missing) return ERROR_INVALID_DATA;
+	if (bytes.size() >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
+		return ERROR_INVALID_DATA; // The native ownership parser requires the same BOM-free record.
+	std::wstring marker;
+	if (!decode_utf8_text(bytes, marker, error)) return error;
+	const size_t stage_separator = stage.find_last_of(L"\\/");
+	if (stage_separator == std::wstring::npos || !valid_owned_run_marker(marker, stage.substr(stage_separator + 1)))
+		return ERROR_INVALID_DATA;
+	if (!read_bounded_regular_file(stage + L"\\ReShade.ini", 1024 * 1024, bytes, missing, error)) return error;
+	if (missing) return ERROR_FILE_NOT_FOUND;
+
+	selected_path = snapshot + L"\\" + leaf;
+	BYTE hash[32] = {};
+	error = hash_immutable_native_file(selected_path, guard.addon_file, hash);
+	if (error != ERROR_SUCCESS) return error;
+	// The expected digest belongs to the still-held staged DLL whose exact
+	// package BID/ABI was validated above. Full content equality also binds this
+	// owned copy to that same PE implementation; no registered-cache path is used.
+	return memcmp(hash, expected_hash, sizeof(hash)) == 0 ? ERROR_SUCCESS : ERROR_REVISION_MISMATCH;
+}
