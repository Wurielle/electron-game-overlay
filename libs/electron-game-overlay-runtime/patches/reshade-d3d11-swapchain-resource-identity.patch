 HRESULT STDMETHODCALLTYPE DXGISwapChain::GetBuffer(UINT Buffer, REFIID riid, void **ppSurface)
 {
-	return _orig->GetBuffer(Buffer, riid, ppSurface);
+	const HRESULT hr = _orig->GetBuffer(Buffer, riid, ppSurface);
+	if (SUCCEEDED(hr) && _direct3d_version == reshade::api::device_api::d3d11)
+	{
+		// DXGI creates composition back buffers without calling our device's
+		// CreateTexture2D. Install the existing ANGLE/Media Foundation identity
+		// hook before exposing any requested resource interface to the caller.
+		com_ptr<ID3D11Resource> resource;
+		if (SUCCEEDED(static_cast<IUnknown *>(*ppSurface)->QueryInterface(&resource)))
+			reshade::hooks::install("ID3D11Resource::GetDevice (swapchain)", reshade::hooks::vtable_from_instance(resource.get()), 3, &ID3D11Resource_GetDevice);
+	}
+	return hr;
 }
