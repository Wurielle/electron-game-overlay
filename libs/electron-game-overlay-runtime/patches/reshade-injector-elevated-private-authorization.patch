+static DWORD read_attachment_token(HANDLE process, attachment_token_context &result)
+{
+    result = {};
+    auto fail = [&](DWORD error, const wchar_t *phase) { result.phase = phase; return error != ERROR_SUCCESS ? error : ERROR_INVALID_DATA; };
+    scoped_handle token;
+    if (!OpenProcessToken(process, TOKEN_QUERY, &token)) return fail(GetLastError(), L"token-open-failed");
+    auto query = [&](TOKEN_INFORMATION_CLASS kind, std::vector<BYTE> &bytes) -> DWORD {
+        // Fixed-size classes need no sizing probe (Windows may return
+        // ERROR_BAD_LENGTH for their zero-size probe). Variable records keep
+        // the ordinary bounded INSUFFICIENT_BUFFER protocol.
+        DWORD length = kind == TokenElevation ? sizeof(TOKEN_ELEVATION) : kind == TokenSessionId ? sizeof(DWORD) : 0;
+        if (length == 0) {
+            SetLastError(ERROR_SUCCESS);
+            const BOOL unexpected_success = GetTokenInformation(token, kind, nullptr, 0, &length);
+            const DWORD sizing_error = GetLastError();
+            if (unexpected_success || sizing_error != ERROR_INSUFFICIENT_BUFFER || length == 0 || length > 65536)
+                return sizing_error != ERROR_SUCCESS && sizing_error != ERROR_INSUFFICIENT_BUFFER ? sizing_error : ERROR_INVALID_DATA;
+        }
+        bytes.resize(length);
+        if (!GetTokenInformation(token, kind, bytes.data(), length, &length)) return GetLastError() != ERROR_SUCCESS ? GetLastError() : ERROR_INVALID_DATA;
+        if (length == 0 || length > bytes.size()) return ERROR_INVALID_DATA;
+        bytes.resize(length); return ERROR_SUCCESS;
+    };
+    std::vector<BYTE> elevation, integrity, user, session;
+    DWORD error = query(TokenElevation, elevation);
+    if (error != ERROR_SUCCESS) return fail(error, L"elevation-query-failed");
+    if (elevation.size() != sizeof(TOKEN_ELEVATION)) return fail(ERROR_INVALID_DATA, L"elevation-size-invalid");
+    const auto elevation_value = reinterpret_cast<const TOKEN_ELEVATION *>(elevation.data())->TokenIsElevated;
+    if (elevation_value > 1) return fail(ERROR_INVALID_DATA, L"elevation-value-invalid");
+    result.elevated = elevation_value != 0;
+    error = query(TokenIntegrityLevel, integrity);
+    if (error != ERROR_SUCCESS) return fail(error, L"integrity-query-failed");
+    error = query(TokenUser, user);
+    if (error != ERROR_SUCCESS) return fail(error, L"user-query-failed");
+    error = query(TokenSessionId, session);
+    if (error != ERROR_SUCCESS) return fail(error, L"session-query-failed");
+    if (integrity.size() < sizeof(TOKEN_MANDATORY_LABEL) || user.size() < sizeof(TOKEN_USER) || session.size() != sizeof(DWORD))
+        return fail(ERROR_INVALID_DATA, L"token-size-invalid");
+    auto bounded_sid = [](PSID sid, const std::vector<BYTE> &buffer) {
+        const auto address = reinterpret_cast<uintptr_t>(sid), start = reinterpret_cast<uintptr_t>(buffer.data());
+        if (address < start || address > start + buffer.size() || start + buffer.size() - address < 8) return false;
+        const auto value = static_cast<const SID *>(sid);
+        const size_t length = 8 + size_t(value->SubAuthorityCount) * sizeof(DWORD);
+        return length <= start + buffer.size() - address && IsValidSid(sid) && GetLengthSid(sid) == length;
+    };
+    const auto label = reinterpret_cast<const TOKEN_MANDATORY_LABEL *>(integrity.data());
+    const auto identity = reinterpret_cast<const TOKEN_USER *>(user.data());
+    if (!bounded_sid(label->Label.Sid, integrity) || !bounded_sid(identity->User.Sid, user)) return fail(ERROR_INVALID_SID, L"token-sid-invalid");
+    if (*GetSidSubAuthorityCount(label->Label.Sid) != 1) return fail(ERROR_INVALID_SID, L"integrity-sid-invalid");
+    const SID_IDENTIFIER_AUTHORITY mandatory = SECURITY_MANDATORY_LABEL_AUTHORITY;
+    if (memcmp(GetSidIdentifierAuthority(label->Label.Sid), &mandatory, sizeof(mandatory)) != 0) return fail(ERROR_INVALID_SID, L"integrity-authority-invalid");
+    result.integrity = *GetSidSubAuthority(label->Label.Sid, 0);
+    result.session = *reinterpret_cast<const DWORD *>(session.data());
+    result.user_sid.resize(GetLengthSid(identity->User.Sid));
+    if (!CopySid(static_cast<DWORD>(result.user_sid.size()), result.user_sid.data(), identity->User.Sid)) return fail(GetLastError(), L"user-sid-copy-failed");
+    result.known = true; result.phase = L"queried"; return ERROR_SUCCESS;
+}
