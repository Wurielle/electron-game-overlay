+static DWORD authorize_attachment_tokens(const attachment_token_context &source, const attachment_token_context &target, const wchar_t *&phase)
+{
+    // This is authorization for the exact retained target handle, not a grant
+    // to elevate it or to run a per-user catalog with an administrator token.
+    if (!source.known || !target.known || source.user_sid.empty() || target.user_sid.empty()) { phase = L"token-context-incomplete"; return ERROR_INVALID_DATA; }
+    if (source.user_sid != target.user_sid) { phase = L"user-mismatch"; return ERROR_ACCESS_DENIED; }
+    if (source.session == 0 || target.session != source.session) { phase = L"interactive-session-mismatch"; return ERROR_ACCESS_DENIED; }
+    auto supported = [](const attachment_token_context &value) {
+        return value.elevated ? value.integrity == SECURITY_MANDATORY_HIGH_RID : value.integrity <= SECURITY_MANDATORY_MEDIUM_RID;
+    };
+    if (!supported(source) || !supported(target)) { phase = L"unsupported-integrity"; return ERROR_ACCESS_DENIED; }
+    if (target.integrity > source.integrity) { phase = L"target-integrity-above-caller"; return ERROR_ACCESS_DENIED; }
+    phase = source.elevated ? L"allowed-private-elevated" : L"allowed"; return ERROR_SUCCESS;
+}
