+static DWORD validate_private_elevated_stage(private_elevated_stage_guard &guard, const attachment_token_context &caller,
+    const BYTE (&expected_runtime_hash)[32], const BYTE (&expected_addon_hash)[32], const BYTE (&expected_ini_hash)[32])
