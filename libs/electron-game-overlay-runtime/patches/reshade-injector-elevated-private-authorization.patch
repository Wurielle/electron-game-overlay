+static bool write_attachment_authorization(DWORD pid, HANDLE process, const attachment_token_context &source,
+    const attachment_token_context &target, DWORD error, const wchar_t *phase)
+{
+    std::wstring line = L"EGO_TARGET_AUTHORIZATION_V1 {\"pid\":" + std::to_wstring(pid);
+    line.append(L",\"targetHandlePid\":" + std::to_wstring(GetProcessId(process)));
+    line.append(L",\"injectorPid\":" + std::to_wstring(GetCurrentProcessId()));
+    line.append(L",\"phase\":"); append_json_string(line, phase);
+    line.append(L",\"windowsError\":" + std::to_wstring(error));
+    auto append = [&](const wchar_t *name, const attachment_token_context &value) {
+        line.append(L",\""); line.append(name); line.append(L"\":{\"phase\":"); append_json_string(line, value.phase);
+        line.append(L",\"elevated\":"); line.append(value.known ? value.elevated ? L"true" : L"false" : L"null");
+        line.append(L",\"integrityRid\":"); line.append(value.known ? std::to_wstring(value.integrity) : L"null");
+        line.append(L",\"sessionId\":"); line.append(value.known ? std::to_wstring(value.session) : L"null"); line.push_back(L'}');
+    };
+    append(L"injector", source); append(L"target", target); line.push_back(L'}');
+    return fwprintf(stdout, L"%ls\n", line.c_str()) >= 0 && fflush(stdout) == 0;
+}
