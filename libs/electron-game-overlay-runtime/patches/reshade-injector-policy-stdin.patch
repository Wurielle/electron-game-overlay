+static DWORD read_process_image_policy(const wchar_t *file, process_image_policy &policy)
+{
+    const scoped_handle input = CreateFileW(file, GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (input == INVALID_HANDLE_VALUE) return GetLastError();
+    LARGE_INTEGER length{};
+    if (!GetFileSizeEx(input, &length) || length.QuadPart < 1 || length.QuadPart > 262144) return ERROR_INVALID_DATA;
+    std::string utf8(static_cast<size_t>(length.QuadPart), '\0');
+    DWORD read = 0;
+    if (!ReadFile(input, utf8.data(), static_cast<DWORD>(utf8.size()), &read, nullptr) || read != utf8.size()) return ERROR_READ_FAULT;
+    return parse_process_image_policy(utf8, policy);
+}
+
+static DWORD read_process_image_policy_stdin(process_image_policy &policy)
+{
+    const HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+    if (input == nullptr || input == INVALID_HANDLE_VALUE || GetFileType(input) != FILE_TYPE_PIPE)
+        return ERROR_INVALID_HANDLE;
+    // Length-prefix the policy so a broken pipe cannot be mistaken for a
+    // complete valid prefix with later deny or exclusion rules omitted.
+    std::string frame;
+    char chunk[4096];
+    for (;;) {
+        DWORD read = 0;
+        if (!ReadFile(input, chunk, sizeof(chunk), &read, nullptr)) {
+            const DWORD error = GetLastError();
+            if (error == ERROR_BROKEN_PIPE) break;
+            return error;
+        }
+        if (read == 0) break;
+        if (frame.size() + read > 262148) return ERROR_INVALID_DATA;
+        frame.append(chunk, read);
+    }
+    if (frame.size() < sizeof(uint32_t)) return ERROR_INVALID_DATA;
+    uint32_t length = 0;
+    memcpy(&length, frame.data(), sizeof(length)); // Windows targets are little endian.
+    if (length != frame.size() - sizeof(length)) return ERROR_INVALID_DATA;
+    return parse_process_image_policy(frame.substr(sizeof(length)), policy);
 }
 
