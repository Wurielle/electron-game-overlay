+static DWORD require_unelevated_process(HANDLE process, preload_authorization_observation *observation = nullptr)
+{
+    preload_authorization_observation local;
+    auto &result = observation != nullptr ? *observation : local;
+    result = {};
+    auto finish = [&result](DWORD error, const wchar_t *phase) {
+        result.phase = phase; result.windows_error = error; return error;
+    };
+    scoped_handle token;
+    if (!OpenProcessToken(process, TOKEN_QUERY, &token)) {
+        const DWORD error = GetLastError();
+        return finish(error != ERROR_SUCCESS ? error : ERROR_ACCESS_DENIED, L"token-open-failed");
+    }
+    TOKEN_ELEVATION elevation{};
+    DWORD size = 0;
+    if (!GetTokenInformation(token, TokenElevation, &elevation, sizeof(elevation), &size)) {
+        const DWORD error = GetLastError(); result.returned_size = size;
+        return finish(error != ERROR_SUCCESS ? error : ERROR_INVALID_DATA, L"elevation-query-failed");
+    }
+    result.returned_size = size;
+    if (size != sizeof(elevation)) return finish(ERROR_ACCESS_DENIED, L"elevation-size-invalid");
+    result.elevation_known = true; result.elevated = elevation.TokenIsElevated != 0;
+    if (result.elevated) return finish(ERROR_ACCESS_DENIED, L"elevated");
+    alignas(TOKEN_MANDATORY_LABEL) BYTE integrity_buffer[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_MANDATORY_LABEL)] = {};
+    if (!GetTokenInformation(token, TokenIntegrityLevel, integrity_buffer, sizeof(integrity_buffer), &size)) {
+        const DWORD error = GetLastError(); result.returned_size = size;
+        return finish(error != ERROR_SUCCESS ? error : ERROR_INVALID_DATA, L"integrity-query-failed");
+    }
+    result.returned_size = size;
+    if (size < sizeof(TOKEN_MANDATORY_LABEL)) return finish(ERROR_INVALID_DATA, L"integrity-size-invalid");
+    const auto label = reinterpret_cast<const TOKEN_MANDATORY_LABEL *>(integrity_buffer);
+    if (!IsValidSid(label->Label.Sid)) return finish(ERROR_INVALID_SID, L"integrity-sid-invalid");
+    const UCHAR count = *GetSidSubAuthorityCount(label->Label.Sid);
+    if (count == 0) return finish(ERROR_INVALID_SID, L"integrity-sid-empty");
+    result.integrity_known = true; result.integrity_rid = *GetSidSubAuthority(label->Label.Sid, count - 1);
+    return finish(result.integrity_rid <= SECURITY_MANDATORY_MEDIUM_RID ? ERROR_SUCCESS : ERROR_ACCESS_DENIED,
+        result.integrity_rid <= SECURITY_MANDATORY_MEDIUM_RID ? L"allowed" : L"integrity-above-medium");
+}
+
+static bool write_preload_authorization_context(DWORD pid, HANDLE process,
+    const preload_authorization_observation &injector, const preload_authorization_observation &target)
+{
+    std::wstring line = L"EGO_PRELOAD_AUTHORIZATION_CONTEXT_V1 {\"pid\":" + std::to_wstring(pid);
+    line.append(L",\"targetHandlePid\":" + std::to_wstring(GetProcessId(process)));
+    line.append(L",\"injectorPid\":" + std::to_wstring(GetCurrentProcessId()));
+    auto append = [&line](const wchar_t *actor, const preload_authorization_observation &value) {
+        line.append(L",\""); line.append(actor); line.append(L"\":{\"phase\":"); append_json_string(line, value.phase);
+        line.append(L",\"windowsError\":" + std::to_wstring(value.windows_error));
+        line.append(L",\"returnedSize\":" + std::to_wstring(value.returned_size));
+        line.append(L",\"elevated\":"); line.append(value.elevation_known ? value.elevated ? L"true" : L"false" : L"null");
+        line.append(L",\"integrityRid\":"); line.append(value.integrity_known ? std::to_wstring(value.integrity_rid) : L"null");
+        line.push_back(L'}');
+    };
+    append(L"injector", injector); append(L"target", target); line.push_back(L'}');
+    return fwprintf(stdout, L"%ls\n", line.c_str()) >= 0 && fflush(stdout) == 0;
 }
 
