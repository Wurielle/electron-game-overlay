+static DWORD find_preloaded_addon(HANDLE process, const std::wstring &leaf, HMODULE &selected)
+{
+	selected = nullptr;
+	HMODULE modules[1024] = {};
+	DWORD bytes = 0;
+	if (!K32EnumProcessModules(process, modules, sizeof(modules), &bytes)) return GetLastError();
+	if (bytes > sizeof(modules)) return ERROR_MORE_DATA;
+	DWORD error = ERROR_SUCCESS;
+	for (DWORD index = 0; index != bytes / sizeof(HMODULE); ++index)
+	{
+		std::wstring path;
+		if (!remote_module_path(process, modules[index], path, error)) return error;
+		const size_t slash = path.find_last_of(L"\\/");
+		if (_wcsicmp(path.c_str() + (slash == std::wstring::npos ? 0 : slash + 1), leaf.c_str()) != 0)
+			continue;
+		if (selected != nullptr) return ERROR_DUP_NAME;
+		selected = modules[index];
+	}
+	return ERROR_SUCCESS;
+}
