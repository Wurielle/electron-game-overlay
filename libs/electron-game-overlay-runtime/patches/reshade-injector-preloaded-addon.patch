+static DWORD validate_mapped_preloaded_addon(HANDLE process, HMODULE module,
+	const std::wstring &leaf, const char (&expected_build)[33], const BYTE (&expected_hash)[32],
+	std::wstring &path, scoped_handle &file_guard)
+{
+	DWORD error = ERROR_SUCCESS;
+	uintptr_t abi_address = 0, build_address = 0, activate_address = 0, name_address = 0;
+	unsigned int abi = 0;
+	char build[33] = {};
+	if (!remote_module_path(process, module, path, error)) return error;
+	if (remote_module_export_address(process, module, "ElectronGameOverlayReShadeAddonAbi",
+		abi_address, error) != module_export_inspection::present ||
+		remote_module_export_address(process, module, "ElectronGameOverlayReShadeAddonBuildId",
+			build_address, error) != module_export_inspection::present ||
+		remote_module_export_address(process, module, "ElectronGameOverlayActivatePreloadedMemberV1",
+			activate_address, error) != module_export_inspection::present ||
+		remote_module_export_address(process, module, "NAME", name_address, error) != module_export_inspection::present ||
+		!read_remote_bytes(process, abi_address, &abi, sizeof(abi), error) || abi != 1 ||
+		!read_remote_bytes(process, build_address, build, sizeof(build), error) ||
+		memcmp(build, expected_build, sizeof(build)) != 0)
+		return error != ERROR_SUCCESS ? error : ERROR_REVISION_MISMATCH;
+	const size_t slash = path.find_last_of(L"\\/");
+	const std::wstring mapped_leaf = path.substr(slash == std::wstring::npos ? 0 : slash + 1);
+	if (!valid_preloaded_addon_leaf(mapped_leaf) || _wcsicmp(mapped_leaf.c_str(), leaf.c_str()) != 0)
+		return ERROR_INVALID_NAME;
+	// NAME is assigned by DllMain, which may still be running when a module
+	// first appears in the OS snapshot. Its value is checked after acquiring
+	// the target loader reference, never used as an early race-prone rejection.
+	BYTE hash[32] = {};
+	error = hash_immutable_native_file(path, file_guard, hash);
+	if (error != ERROR_SUCCESS) return error;
+	return memcmp(hash, expected_hash, sizeof(hash)) == 0 ? ERROR_SUCCESS : ERROR_INVALID_DATA;
+}
