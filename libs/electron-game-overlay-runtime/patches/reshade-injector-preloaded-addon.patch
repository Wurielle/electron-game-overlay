+static DWORD hash_immutable_native_file(const std::wstring &path, scoped_handle &guard,
+	BYTE (&digest)[32])
+{
+	// Keep this exact regular file open through activation. A mapped module
+	// whose file vanished or changed is not permission to use a different DLL.
+	guard.handle = CreateFileW(make_extended_length_path(path).c_str(), GENERIC_READ,
+		FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+	if (guard == INVALID_HANDLE_VALUE) return GetLastError();
+	BY_HANDLE_FILE_INFORMATION info{};
+	LARGE_INTEGER length{};
+	if (!GetFileInformationByHandle(guard, &info) || !GetFileSizeEx(guard, &length)) return GetLastError();
+	if ((info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) != 0)
+		return ERROR_CANT_ACCESS_FILE;
+	if (length.QuadPart <= 0 || length.QuadPart > 512 * 1024 * 1024) return ERROR_FILE_TOO_LARGE;
+	BCRYPT_ALG_HANDLE algorithm = nullptr;
+	BCRYPT_HASH_HANDLE hash = nullptr;
+	NTSTATUS status = BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_SHA256_ALGORITHM, nullptr, 0);
+	if (status >= 0) status = BCryptCreateHash(algorithm, &hash, nullptr, 0, nullptr, 0, 0);
+	DWORD error = status >= 0 ? ERROR_SUCCESS : ERROR_INVALID_DATA;
+	BYTE buffer[64 * 1024];
+	ULONGLONG remaining = static_cast<ULONGLONG>(length.QuadPart);
+	while (error == ERROR_SUCCESS && remaining != 0)
+	{
+		DWORD read = 0;
+		const DWORD requested = static_cast<DWORD>(std::min<ULONGLONG>(remaining, sizeof(buffer)));
+		if (!ReadFile(guard, buffer, requested, &read, nullptr)) error = GetLastError();
+		else if (read == 0 || read > requested) error = ERROR_HANDLE_EOF;
+		else if (BCryptHashData(hash, buffer, read, 0) < 0) error = ERROR_INVALID_DATA;
+		else remaining -= read;
+	}
+	if (error == ERROR_SUCCESS && BCryptFinishHash(hash, digest, sizeof(digest), 0) < 0)
+		error = ERROR_INVALID_DATA;
+	if (hash != nullptr) BCryptDestroyHash(hash);
+	if (algorithm != nullptr) BCryptCloseAlgorithmProvider(algorithm, 0);
+	return error;
+}
