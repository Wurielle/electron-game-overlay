+static DWORD require_unelevated_process(HANDLE process)
+{
+	scoped_handle token;
+	if (!OpenProcessToken(process, TOKEN_QUERY, &token))
+	{
+		const DWORD error = GetLastError();
+		return error != ERROR_SUCCESS ? error : ERROR_ACCESS_DENIED;
+	}
+	TOKEN_ELEVATION elevation{};
+	DWORD size = 0;
+	if (!GetTokenInformation(token, TokenElevation, &elevation, sizeof(elevation), &size))
+	{
+		const DWORD error = GetLastError();
+		return error != ERROR_SUCCESS ? error : ERROR_INVALID_DATA;
+	}
+	if (size != sizeof(elevation) || elevation.TokenIsElevated != 0) return ERROR_ACCESS_DENIED;
+	alignas(TOKEN_MANDATORY_LABEL) BYTE integrity_buffer[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_MANDATORY_LABEL)] = {};
+	if (!GetTokenInformation(token, TokenIntegrityLevel, integrity_buffer, sizeof(integrity_buffer), &size))
+	{
+		const DWORD error = GetLastError();
+		return error != ERROR_SUCCESS ? error : ERROR_INVALID_DATA;
+	}
+	if (size < sizeof(TOKEN_MANDATORY_LABEL)) return ERROR_INVALID_DATA;
+	const auto label = reinterpret_cast<const TOKEN_MANDATORY_LABEL *>(integrity_buffer);
+	if (!IsValidSid(label->Label.Sid)) return ERROR_INVALID_SID;
+	const UCHAR count = *GetSidSubAuthorityCount(label->Label.Sid);
+	if (count == 0) return ERROR_INVALID_SID;
+	return *GetSidSubAuthority(label->Label.Sid, count - 1) <= SECURITY_MANDATORY_MEDIUM_RID
+		? ERROR_SUCCESS : ERROR_ACCESS_DENIED;
+}
