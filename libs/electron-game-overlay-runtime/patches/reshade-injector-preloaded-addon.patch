+static bool preloaded_addon_disabled(const target_effective_reshade_settings &settings,
+	const std::wstring &leaf)
+{
+	if (settings.electron_game_overlay_addon_disabled) return true;
+	const std::wstring name = L"Electron Game Overlay Runtime " + leaf;
+	for (const auto &disabled : settings.disabled_addons)
+	{
+		if (_wcsicmp(disabled.c_str(), name.c_str()) == 0) return true;
+		// Stock's directory scanner rejects every NAME@file entry by the
+		// filename suffix, including an empty or unrecognized NAME prefix.
+		const size_t at = disabled.find(L'@');
+		if (at != std::wstring::npos &&
+			(_wcsicmp(disabled.c_str() + at + 1, leaf.c_str()) == 0 ||
+			 _wcsicmp(disabled.c_str() + at + 1, target_electron_overlay_addon_file) == 0))
+			return true;
+	}
+	return false;
+}
