+// A preload is selected only by an immutable per-app leaf, never by a caller-
+// supplied directory. Its bytes and mapped identity are validated separately.
+static bool valid_preloaded_addon_leaf(const std::wstring &leaf)
+{
+	constexpr size_t prefix_size = sizeof("ego-preload-") - 1;
+	constexpr size_t app_begin = prefix_size;
+	constexpr size_t build_begin = app_begin + 32 + 1;
+	constexpr size_t hash_begin = build_begin + 32 + 1;
+	constexpr size_t suffix_begin = hash_begin + 16;
+#ifdef _WIN64
+	constexpr wchar_t suffix[] = L".addon64";
+#else
+	constexpr wchar_t suffix[] = L".addon32";
+#endif
+	if (leaf.size() != suffix_begin + ARRAYSIZE(suffix) - 1 ||
+		leaf.compare(0, prefix_size, L"ego-preload-") != 0 ||
+		leaf[app_begin + 32] != L'-' || leaf[build_begin + 32] != L'-' ||
+		leaf.compare(suffix_begin, ARRAYSIZE(suffix) - 1, suffix) != 0)
+		return false;
+	for (size_t index = app_begin; index != suffix_begin; ++index)
+	{
+		if (index == app_begin + 32 || index == build_begin + 32) continue;
+		const wchar_t digit = leaf[index];
+		if (!((digit >= L'0' && digit <= L'9') || (digit >= L'a' && digit <= L'f') ||
+			(digit >= L'A' && digit <= L'F')))
+			return false;
+	}
+	return true;
+}
+
+static bool bind_preloaded_addon_leaf(const std::wstring &leaf,
+	const char (&build)[33], const BYTE (&hash)[32])
+{
+	if (!valid_preloaded_addon_leaf(leaf)) return false;
+	constexpr size_t build_begin = sizeof("ego-preload-") - 1 + 32 + 1;
+	constexpr size_t hash_begin = build_begin + 32 + 1;
+	constexpr wchar_t hex[] = L"0123456789abcdef";
+	for (size_t index = 0; index != 32; ++index)
+		if (towlower(leaf[build_begin + index]) != towlower(static_cast<unsigned char>(build[index])))
+			return false;
+	for (size_t index = 0; index != 8; ++index)
+		if (towlower(leaf[hash_begin + index * 2]) != hex[hash[index] >> 4] ||
+			towlower(leaf[hash_begin + index * 2 + 1]) != hex[hash[index] & 15])
+			return false;
+	return build[32] == '\0';
+}
