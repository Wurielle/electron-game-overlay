+static DWORD staged_participant_path(std::wstring &path)
+{
+	WCHAR executable[32768] = L"";
+	const DWORD length = GetModuleFileNameW(nullptr, executable, ARRAYSIZE(executable));
+	if (length == 0 || length >= ARRAYSIZE(executable))
+		return ERROR_INSUFFICIENT_BUFFER;
+	WCHAR *const leaf = wcsrchr(executable, L'\\');
+	if (leaf == nullptr)
+		return ERROR_BAD_PATHNAME;
+	*leaf = L'\0';
+	path = executable;
+	path += L'\\';
+	path += target_electron_overlay_addon_file;
+	return ERROR_SUCCESS;
+}
+
+static DWORD validate_staged_participant(const std::wstring &path, char (&build)[33])
+{
+	// Map only for bounded PE/data inspection: no DllMain or imports execute.
+	const HMODULE image = LoadLibraryExW(path.c_str(), nullptr, DONT_RESOLVE_DLL_REFERENCES);
+	if (image == nullptr)
+		return GetLastError();
+	DWORD error = ERROR_SUCCESS;
+	uintptr_t abi_address = 0, build_address = 0, initializer_address = 0;
+	unsigned int abi = 0;
+	reusable_runtime_info verified;
+	const std::vector<HMODULE> images{image};
+	// Reuse the existing exact-build validator. The package build updates its
+	// single expected build ID; do not maintain a second identity constant.
+	const bool exact_build = inspect_target_for_official_addon(
+		GetCurrentProcess(), images, images.size(), verified, error) == target_preflight_result::official_addon;
+	const bool valid =
+		exact_build &&
+		remote_module_export_address(GetCurrentProcess(), image,
+			"ElectronGameOverlayReShadeAddonAbi", abi_address, error) == module_export_inspection::present &&
+		remote_module_export_address(GetCurrentProcess(), image,
+			"ElectronGameOverlayReShadeAddonBuildId", build_address, error) == module_export_inspection::present &&
+		remote_module_export_address(GetCurrentProcess(), image,
+			"ElectronGameOverlayInitializeMember", initializer_address, error) == module_export_inspection::present &&
+		read_remote_bytes(GetCurrentProcess(), abi_address, &abi, sizeof(abi), error) && abi == 1 &&
+		read_remote_bytes(GetCurrentProcess(), build_address, build, sizeof(build), error);
+	FreeLibrary(image);
+	return valid ? ERROR_SUCCESS : error != ERROR_SUCCESS ? error : ERROR_REVISION_MISMATCH;
+}
+
+static DWORD inspect_cooperative_host(HANDLE process, HMODULE &runtime, bool &ready, bool *present = nullptr)
+{
+	HMODULE modules[1024] = {};
+	DWORD bytes = 0;
+	if (!K32EnumProcessModules(process, modules, sizeof(modules), &bytes))
+		return GetLastError();
+	if (bytes > sizeof(modules))
+		return ERROR_MORE_DATA;
+	runtime = nullptr;
+	ready = false;
+	if (present != nullptr) *present = false;
+	DWORD error = ERROR_SUCCESS;
+	for (DWORD i = 0; i != bytes / sizeof(HMODULE); ++i)
+	{
+		uintptr_t address = 0;
+		const auto reshade = remote_module_export_address(process, modules[i], "ReShadeVersion", address, error);
+		if (reshade == module_export_inspection::failed)
+			return error;
+		if (reshade == module_export_inspection::present)
+		{
+			if (runtime != nullptr)
+				return ERROR_REVISION_MISMATCH;
+			runtime = modules[i];
+		}
+		const auto participant = remote_module_export_address(process, modules[i],
+			"ElectronGameOverlayCooperativeReadyV1", address, error);
+		if (participant == module_export_inspection::failed)
+			return error;
+		if (participant == module_export_inspection::present)
+		{
+			if (present != nullptr) *present = true;
+			LONG value = 0;
+			if (!read_remote_bytes(process, address, &value, sizeof(value), error))
+				return error;
+			ready = ready || value == 1;
+		}
+	}
+	return ERROR_SUCCESS;
+}
