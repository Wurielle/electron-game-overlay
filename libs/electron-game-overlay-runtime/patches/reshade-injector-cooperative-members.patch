+enum class persistent_host_claim_result { first_owner, already_pinned, failed };
+
+static DWORD host_claim_name(HANDLE process, DWORD pid, std::wstring &name)
+{
+	FILETIME creation{}, exit{}, kernel{}, user{};
+	if (!GetProcessTimes(process, &creation, &exit, &kernel, &user))
+	{
+		return GetLastError();
+	}
+	const uint64_t instance = (static_cast<uint64_t>(creation.dwHighDateTime) << 32) | creation.dwLowDateTime;
+	if (instance == 0)
+	{
+		return ERROR_INVALID_DATA;
+	}
+	name = L"Local\\electron-game-overlay-host-v1-" + std::to_wstring(pid) + L"-" + std::to_wstring(instance);
+	return ERROR_SUCCESS;
+}
+
+static DWORD host_claim_is_pinned(HANDLE process, DWORD pid, bool &pinned)
+{
+	pinned = false;
+	std::wstring name;
+	DWORD error = host_claim_name(process, pid, name);
+	if (error != ERROR_SUCCESS) return error;
+	const scoped_handle mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, name.c_str());
+	if (mapping != nullptr)
+	{
+		pinned = true;
+		return ERROR_SUCCESS;
+	}
+	error = GetLastError();
+	return error == ERROR_FILE_NOT_FOUND ? ERROR_SUCCESS : error;
+}
+
+static persistent_host_claim_result pin_host_claim(HANDLE process, DWORD pid, DWORD &error)
+{
+	std::wstring name;
+	error = host_claim_name(process, pid, name);
+	if (error != ERROR_SUCCESS) return persistent_host_claim_result::failed;
+	SetLastError(ERROR_SUCCESS);
+	const scoped_handle mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, 64, name.c_str());
+	const DWORD created = GetLastError();
+	if (mapping == nullptr)
+	{
+		error = created;
+		return persistent_host_claim_result::failed;
+	}
+	if (created == ERROR_ALREADY_EXISTS)
+		return persistent_host_claim_result::already_pinned;
+	HANDLE target_copy = nullptr;
+	if (!DuplicateHandle(GetCurrentProcess(), mapping, process, &target_copy, 0, FALSE, DUPLICATE_SAME_ACCESS))
+	{
+		error = GetLastError();
+		return persistent_host_claim_result::failed;
+	}
+	// This target-owned handle is deliberately never closed by the injector.
+	// Mere existence freezes full-runtime ownership through injector/app crashes
+	// and zero-member intervals; the OS releases it on exact process exit.
+	error = ERROR_SUCCESS;
+	return persistent_host_claim_result::first_owner;
+}
