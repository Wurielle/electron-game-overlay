+struct participant_loading_data
+{
+	WCHAR load_path[32768] = L"";
+	char initializer_name[48] = "ElectronGameOverlayInitializeMember";
+	char can_unload_name[48] = "ElectronGameOverlayCanUnloadFailedMemberV1";
+	char build_id_name[48] = "ElectronGameOverlayReShadeAddonBuildId";
+	char abi_name[48] = "ElectronGameOverlayReShadeAddonAbi";
+	char expected_build_id[33] = {};
+	decltype(&LoadLibraryW) load_library = nullptr;
+	decltype(&FreeLibrary) free_library = nullptr;
+	decltype(&GetProcAddress) get_proc_address = nullptr;
+	decltype(&GetLastError) get_last_error = nullptr;
+	HMODULE loaded_module = nullptr;
+	DWORD initialization_error = ERROR_GEN_FAILURE;
+};
+
+#ifndef _WIN64
+__declspec(noinline) __declspec(code_seg(".egomember$z"))
+static DWORD WINAPI participant_loading_thread_end(participant_loading_data *)
+{
+	// Keep this marker distinct from the legacy loader marker so /OPT:ICF
+	// cannot fold their addresses across the two ordered code segments.
+	return 0x45474F4D;
+}
+#endif
+
+#pragma optimize("", off)
+__declspec(noinline)
+#ifndef _WIN64
+__declspec(code_seg(".egomember$m"))
+#endif
+static DWORD WINAPI participant_loading_thread(participant_loading_data *data)
+{
+	data->loaded_module = data->load_library(data->load_path);
+	if (data->loaded_module == nullptr)
+	{
+		data->initialization_error = data->get_last_error();
+		if (data->initialization_error == ERROR_SUCCESS)
+			data->initialization_error = ERROR_MOD_NOT_FOUND;
+		return data->initialization_error;
+	}
+	const auto abi = reinterpret_cast<const unsigned int *>(
+		data->get_proc_address(data->loaded_module, data->abi_name));
+	const auto build = reinterpret_cast<const char *>(
+		data->get_proc_address(data->loaded_module, data->build_id_name));
+	if (abi == nullptr || *abi != 1 || build == nullptr)
+	{
+		data->initialization_error = ERROR_REVISION_MISMATCH;
+		return data->initialization_error;
+	}
+	for (unsigned int i = 0; i != sizeof(data->expected_build_id); ++i)
+	{
+		if (build[i] != data->expected_build_id[i])
+		{
+			data->initialization_error = ERROR_REVISION_MISMATCH;
+			return data->initialization_error;
+		}
+	}
+	using initialize_member = DWORD (WINAPI *)(void *);
+	const auto initialize = reinterpret_cast<initialize_member>(
+		data->get_proc_address(data->loaded_module, data->initializer_name));
+	if (initialize == nullptr)
+	{
+		data->initialization_error = ERROR_PROC_NOT_FOUND;
+		return data->initialization_error;
+	}
+	// Initialization runs after LoadLibrary/DllMain returned. The member derives
+	// its private rendezvous from its own module parent, never process-wide env.
+	data->initialization_error = initialize(nullptr);
+	if (data->initialization_error != ERROR_SUCCESS)
+	{
+		// Only the exact module can prove that failed initialization published
+		// no callbacks and acquired no permanent pin. An initializer error alone
+		// is insufficient, and absence of this optional export remains resident.
+		using can_unload_failed_member = DWORD (WINAPI *)();
+		const auto can_unload = reinterpret_cast<can_unload_failed_member>(
+			data->get_proc_address(data->loaded_module, data->can_unload_name));
+		if (can_unload != nullptr && can_unload() == 1 &&
+			data->free_library(data->loaded_module))
+			data->loaded_module = nullptr;
+	}
+	return data->initialization_error;
+}
+#pragma optimize("", on)
+
+static bool participant_loading_thread_size(SIZE_T &size)
+{
+	constexpr SIZE_T maximum = 4096;
+#ifdef _WIN64
+	const DWORD64 start = reinterpret_cast<DWORD64>(participant_loading_thread);
+	DWORD64 image = 0;
+	const RUNTIME_FUNCTION *const entry = RtlLookupFunctionEntry(start, &image, nullptr);
+	if (entry == nullptr || image + entry->BeginAddress != start ||
+		entry->EndAddress <= entry->BeginAddress ||
+		entry->EndAddress - entry->BeginAddress > maximum)
+		return false;
+	size = entry->EndAddress - entry->BeginAddress;
+#else
+	const uintptr_t start = reinterpret_cast<uintptr_t>(participant_loading_thread);
+	const uintptr_t end = reinterpret_cast<uintptr_t>(participant_loading_thread_end);
+	if (end <= start || end - start > maximum)
+		return false;
+	size = end - start;
+#endif
+	return true;
+}
