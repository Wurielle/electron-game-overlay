+static DWORD process_token_session_id(HANDLE process, DWORD &session)
+{
+	scoped_handle token;
+	if (!OpenProcessToken(process, TOKEN_QUERY, &token))
+	{
+		const DWORD error = GetLastError();
+		return error != ERROR_SUCCESS ? error : ERROR_ACCESS_DENIED;
+	}
+	DWORD size = 0;
+	if (!GetTokenInformation(token, TokenSessionId, &session, sizeof(session), &size))
+	{
+		const DWORD error = GetLastError();
+		return error != ERROR_SUCCESS ? error : ERROR_INVALID_DATA;
+	}
+	return size == sizeof(session) ? ERROR_SUCCESS : ERROR_INVALID_DATA;
+}
+
+static DWORD compare_process_sessions(DWORD current, DWORD target, bool &mismatch)
+{
+	mismatch = current != target;
+	return mismatch ? ERROR_ACCESS_DENIED : ERROR_SUCCESS;
+}
+
+static DWORD require_same_process_session(HANDLE process, bool &mismatch)
+{
+	mismatch = false;
+	DWORD current = 0, target = 0;
+	DWORD error = process_token_session_id(GetCurrentProcess(), current);
+	if (error == ERROR_SUCCESS) error = process_token_session_id(process, target);
+	return error != ERROR_SUCCESS ? error : compare_process_sessions(current, target, mismatch);
+}
