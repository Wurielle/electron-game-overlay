+static DWORD load_participant_only(HANDLE process, DWORD pid, const std::wstring &image_path)
+{
+	std::wstring addon_path;
+	char validated_build_id[33] = {};
+	DWORD error = staged_participant_path(addon_path);
+	if (error == ERROR_SUCCESS)
+		error = validate_staged_participant(addon_path, validated_build_id);
+	if (error != ERROR_SUCCESS)
+	{
+		write_injector_diagnostic(L"target-member-payload-invalid", pid, addon_path, error, image_path);
+		print_injection_not_started();
+		return error;
+	}
+	const ULONGLONG deadline = GetTickCount64() + participant_attach_timeout_ms;
+	HMODULE runtime = nullptr;
+	for (;;)
+	{
+		bool ready = false;
+		error = inspect_cooperative_host(process, runtime, ready);
+		if (error == ERROR_SUCCESS && runtime != nullptr && ready)
+			break;
+		if (error != ERROR_SUCCESS && error != ERROR_PARTIAL_COPY && error != ERROR_BAD_LENGTH)
+			break;
+		if (GetTickCount64() >= deadline)
+		{
+			error = ERROR_TIMEOUT;
+			break;
+		}
+		if (WaitForSingleObject(process, 10) == WAIT_OBJECT_0)
+		{
+			error = ERROR_PROCESS_ABORTED;
+			break;
+		}
+	}
+	if (error != ERROR_SUCCESS)
+	{
+		write_injector_diagnostic(L"target-member-host-unavailable", pid, addon_path, error, image_path);
+		print_injection_not_started();
+		return error;
+	}
+	std::wstring runtime_path;
+	if (!remote_module_path(process, runtime, runtime_path, error))
+	{
+		print_injection_not_started();
+		return error;
+	}
+	target_environment environment;
+	target_reshade_configuration configuration;
+	target_effective_reshade_settings settings;
+	if (!inspect_target_environment(process, environment, error) ||
+		inspect_target_reshade_configuration(image_path, environment, configuration, error) == module_export_inspection::failed ||
+		!inspect_target_effective_reshade_settings(image_path, runtime_path, process,
+			environment, configuration, settings, error))
+	{
+		write_injector_diagnostic(L"target-module-inspection-failed", pid, runtime_path, error, image_path);
+		print_injection_not_started();
+		return error != ERROR_SUCCESS ? error : ERROR_INVALID_DATA;
+	}
+	if (settings.electron_game_overlay_addon_disabled)
+	{
+		write_injector_diagnostic(L"target-member-disabled", pid, runtime_path, ERROR_ACCESS_DISABLED_BY_POLICY, image_path, &settings);
+		print_injection_not_started();
+		return ERROR_ACCESS_DISABLED_BY_POLICY;
+	}
+	SIZE_T code_size = 0;
+	if (!participant_loading_thread_size(code_size))
+	{
+		print_injection_not_started();
+		return ERROR_BAD_EXE_FORMAT;
+	}
+	participant_loading_data data;
+	if (wcscpy_s(data.load_path, addon_path.c_str()) != 0)
+	{
+		print_injection_not_started();
+		return ERROR_FILENAME_EXCED_RANGE;
+	}
+	memcpy(data.expected_build_id, validated_build_id, sizeof(data.expected_build_id));
+	data.load_library = LoadLibraryW;
+	data.free_library = FreeLibrary;
+	data.get_proc_address = GetProcAddress;
+	data.get_last_error = GetLastError;
+	const SIZE_T allocation_size = sizeof(data) + code_size;
+	BYTE *const allocation = static_cast<BYTE *>(VirtualAllocEx(process, nullptr, allocation_size,
+		MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
+	if (allocation == nullptr ||
+		!WriteProcessMemory(process, allocation, &data, sizeof(data), nullptr) ||
+		!WriteProcessMemory(process, allocation + sizeof(data), participant_loading_thread, code_size, nullptr) ||
+		!FlushInstructionCache(process, allocation + sizeof(data), code_size))
+	{
+		error = GetLastError();
+		if (allocation != nullptr) VirtualFreeEx(process, allocation, 0, MEM_RELEASE);
+		print_injection_not_started();
+		return error;
+	}
+	const scoped_handle thread = CreateRemoteThread(process, nullptr, 0,
+		reinterpret_cast<LPTHREAD_START_ROUTINE>(allocation + sizeof(data)), allocation, 0, nullptr);
+	if (thread == nullptr)
+	{
+		error = GetLastError();
+		VirtualFreeEx(process, allocation, 0, MEM_RELEASE);
+		print_injection_not_started();
+		return error;
+	}
+	const DWORD wait = WaitForSingleObject(thread, participant_attach_timeout_ms);
+	if (wait != WAIT_OBJECT_0)
+	{
+		// Remote code may still use its arguments. Keep memory/module ownership
+		// indeterminate; neither terminate it nor free it or inject a runtime.
+		error = wait == WAIT_TIMEOUT ? ERROR_TIMEOUT : GetLastError();
+		return error != ERROR_SUCCESS ? error : ERROR_GEN_FAILURE;
+	}
+	DWORD exit_code = ERROR_GEN_FAILURE;
+	bool read = GetExitCodeThread(thread, &exit_code) != FALSE;
+	if (!read)
+	{
+		error = GetLastError();
+		if (error == ERROR_SUCCESS) error = ERROR_GEN_FAILURE;
+	}
+	else
+		read = read_remote_bytes(process, reinterpret_cast<uintptr_t>(allocation), &data, sizeof(data), error);
+	VirtualFreeEx(process, allocation, 0, MEM_RELEASE);
+	if (!read || exit_code != ERROR_SUCCESS || data.initialization_error != ERROR_SUCCESS)
+		return !read ? error : exit_code != ERROR_SUCCESS ? exit_code : data.initialization_error;
+	std::wstring loaded_path;
+	if (!remote_module_path(process, data.loaded_module, loaded_path, error) ||
+		!remote_module_path(process, runtime, runtime_path, error))
+		return error;
+	if (_wcsicmp(loaded_path.c_str(), addon_path.c_str()) != 0)
+		return ERROR_INVALID_NAME;
+	std::wstring result = L"ELECTRON_GAME_OVERLAY_INJECTOR_RESULT {\"schemaVersion\":1,\"pid\":";
+	result += std::to_wstring(pid);
+	result += L",\"targetExecutablePath\":";
+	append_json_string(result, image_path);
+	result += L",\"runtimeMode\":\"participant-addon\",\"runtimeModulePath\":";
+	append_json_string(result, runtime_path);
+	result += L",\"addonModulePath\":";
+	append_json_string(result, loaded_path);
+	result += L",\"reshadeBasePath\":";
+	append_json_string(result, settings.reshade_base_path);
+	result += L",\"addonAbi\":1,\"memberProtocolVersion\":1}";
+	wprintf(L"Found a matching process with PID %lu! Loading Electron Game Overlay participant into existing ReShade ... Succeeded!\n", pid);
+	fflush(stdout);
+	return write_utf8_stdout_line(result) ? ERROR_SUCCESS : ERROR_WRITE_FAULT;
+}
