+static bool write_initial_module_inspection_summary(
+	const initial_module_inspection_observation &observation)
+{
+	// Separate optional telemetry preserves the existing strict diagnostic and
+	// result record shapes. A recovered read-only failure is not an injection.
+	std::wstring line = L"EGO_INITIAL_MODULE_INSPECTION_V1 {\"phase\":";
+	append_json_string(line, observation.phase);
+	line.append(L",\"attempts\":");
+	line.append(std::to_wstring(observation.attempts));
+	line.append(L",\"elapsedMs\":");
+	line.append(std::to_wstring(observation.elapsed_ms));
+	line.append(L",\"firstWindowsError\":");
+	line.append(std::to_wstring(observation.first_error));
+	line.append(L",\"lastWindowsError\":");
+	line.append(std::to_wstring(observation.last_error));
+	line.push_back(L'}');
+	return fwprintf(stdout, L"%ls\n", line.c_str()) >= 0 && fflush(stdout) == 0;
+}
