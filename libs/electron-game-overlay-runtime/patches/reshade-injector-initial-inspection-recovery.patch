+// Only the initial preflight uses this recovery budget. Its caller holds the
+// already identity-bound process handle and the injection mutex; no persistent
+// ownership, target allocation, thread or payload load has been published.
+static DWORD host_claim_is_pinned(HANDLE process, DWORD pid, bool &pinned);
+
+static DWORD inspect_initial_host_readonly(
+	HANDLE process, DWORD pid, bool &pinned, HMODULE &runtime,
+	bool &ready, bool &cooperative_present, owned_late_d3d11_host &owned_late,
+	initial_module_inspection_observation &observation)
+{
+	constexpr ULONGLONG retry_budget_ms = 250;
+	constexpr unsigned int maximum_attempts = 256;
+	const ULONGLONG started = GetTickCount64();
+	observation = {};
+	bool pinned_observed = false;
+	bool ownership_observed = false;
+	const wchar_t *last_failure_phase = L"not-started";
+	const auto clear_outputs = [&]() {
+		pinned = false;
+		runtime = nullptr;
+		ready = false;
+		cooperative_present = false;
+		owned_late = {};
+	};
+	const auto finish = [&](DWORD error) {
+		observation.elapsed_ms = GetTickCount64() - started;
+		observation.last_error = error;
+		if (error != ERROR_SUCCESS && observation.first_error == ERROR_SUCCESS)
+			observation.first_error = error;
+		if (error != ERROR_SUCCESS) clear_outputs();
+		return error;
+	};
+	const auto wait_for_target = [&](DWORD milliseconds) {
+		const DWORD result = WaitForSingleObject(process, milliseconds);
+		if (result == WAIT_TIMEOUT) return static_cast<DWORD>(ERROR_SUCCESS);
+		observation.phase = L"process-liveness";
+		if (result == WAIT_OBJECT_0) return static_cast<DWORD>(ERROR_PROCESS_ABORTED);
+		const DWORD error = result == WAIT_FAILED ? GetLastError() : ERROR_GEN_FAILURE;
+		return error != ERROR_SUCCESS ? error : static_cast<DWORD>(ERROR_GEN_FAILURE);
+	};
+	for (;;)
+	{
+		clear_outputs();
+		DWORD error = wait_for_target(0);
+		if (error != ERROR_SUCCESS) return finish(error);
+		++observation.attempts;
+		observation.phase = L"host-claim";
+		error = host_claim_is_pinned(process, pid, pinned);
+		if (error == ERROR_SUCCESS)
+		{
+			pinned_observed = pinned_observed || pinned;
+			pinned = pinned_observed;
+		}
+		bool observed_by_scan = false;
+		if (error == ERROR_SUCCESS)
+			error = inspect_cooperative_host(process, runtime, ready,
+				&cooperative_present, nullptr, &observation.phase, &observed_by_scan);
+		ownership_observed = ownership_observed || observed_by_scan;
+		if (error == ERROR_SUCCESS)
+		{
+			observation.phase = L"owned-late-host";
+			error = inspect_owned_late_d3d11_host(process, runtime, owned_late);
+		}
+		if (error == ERROR_SUCCESS && ownership_observed && !observed_by_scan)
+		{
+			error = ERROR_PARTIAL_COPY;
+			observation.phase = L"host-evidence-lost";
+		}
+		observation.elapsed_ms = GetTickCount64() - started;
+		if (error == ERROR_SUCCESS)
+		{
+			// After recovery, phase identifies the last failed read-only stage.
+			observation.phase = observation.first_error != ERROR_SUCCESS
+				? last_failure_phase : L"complete";
+			return finish(ERROR_SUCCESS);
+		}
+		if (observation.first_error == ERROR_SUCCESS) observation.first_error = error;
+		last_failure_phase = observation.phase;
+		if (!is_transient_module_inspection_error(error) ||
+			observation.elapsed_ms >= retry_budget_ms || observation.attempts >= maximum_attempts)
+			return finish(error);
+		const DWORD wait_error = wait_for_target(1);
+		if (wait_error != ERROR_SUCCESS) return finish(wait_error);
+		if (GetTickCount64() - started >= retry_budget_ms) return finish(error);
+	}
+}
