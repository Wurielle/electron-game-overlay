diff --git a/source/ego_owned_late_d3d11/compatibility_snapshot.hpp b/source/ego_owned_late_d3d11/compatibility_snapshot.hpp
new file mode 100644
--- /dev/null
+++ b/source/ego_owned_late_d3d11/compatibility_snapshot.hpp
@@ -0,0 +1,114 @@
+// Bounded observation only. Include after dll_log.hpp; never calls a callback or COM method.
+#pragma once
+#include <Windows.h>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+extern HMODULE g_module_handle;
+namespace ego_compatibility_snapshot {
+    struct error_scope { DWORD value = GetLastError(); ~error_scope() { SetLastError(value); } };
+    inline std::atomic<unsigned> emitted { 0 };
+    inline thread_local unsigned discovery_depth = 0;
+    struct discovery_scope { discovery_scope() { ++discovery_depth; } ~discovery_scope() { --discovery_depth; } };
+    inline bool once(unsigned bit) noexcept { return (emitted.load(std::memory_order_relaxed) & bit) == 0 && (emitted.fetch_or(bit, std::memory_order_relaxed) & bit) == 0; }
+    inline const char *owner(const void *address) noexcept {
+        error_scope preserve;
+        if (address == nullptr) return "absent";
+        MEMORY_BASIC_INFORMATION memory {};
+        if (VirtualQuery(address, &memory, sizeof(memory)) != sizeof(memory)) return "unknown";
+        if (memory.Type == MEM_PRIVATE) return "private-code";
+        if (memory.Type != MEM_IMAGE) return "other-memory";
+        const auto module = static_cast<HMODULE>(memory.AllocationBase);
+        if (module == g_module_handle) return "reshade-host";
+        if (module == GetModuleHandleW(L"dxgi.dll")) return "dxgi";
+        if (module == GetModuleHandleW(L"d3d11.dll")) return "d3d11";
+#ifdef _WIN64
+        if (module == GetModuleHandleW(L"GameOverlayRenderer64.dll")) return "steam-renderer";
+#else
+        if (module == GetModuleHandleW(L"GameOverlayRenderer.dll")) return "steam-renderer";
+#endif
+        return "other-image";
+    }
+    struct entry_jump { const char *owner; unsigned hops; };
+    inline entry_jump observe_entry_jump(const void *address) noexcept {
+        error_scope preserve;
+        unsigned hops = 0;
+        // Read only six instruction bytes and at most one pointer per hop.
+        // ReadProcessMemory safely refuses inaccessible/racing mappings. Never execute or dump them.
+        for (; hops != 2 && address != nullptr;) {
+            unsigned char code[6] {}; SIZE_T copied = 0;
+            if (!ReadProcessMemory(GetCurrentProcess(), address, code, sizeof(code), &copied) || copied != sizeof(code))
+                return { "unreadable", hops };
+            const auto origin = reinterpret_cast<std::uintptr_t>(address);
+            if (code[0] == 0xE9) {
+                std::int32_t offset; std::memcpy(&offset, code + 1, sizeof(offset));
+                address = reinterpret_cast<const void *>(origin + 5 + offset);
+            } else if (code[0] == 0xFF && code[1] == 0x25) {
+                std::uintptr_t slot;
+#ifdef _WIN64
+                std::int32_t offset; std::memcpy(&offset, code + 2, sizeof(offset)); slot = origin + 6 + offset;
+#else
+                std::uint32_t absolute; std::memcpy(&absolute, code + 2, sizeof(absolute)); slot = absolute;
+#endif
+                const void *destination = nullptr;
+                if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void *>(slot), &destination, sizeof(destination), &copied) || copied != sizeof(destination))
+                    return { "unreadable", hops };
+                address = destination;
+            } else break;
+            ++hops;
+        }
+        return { hops != 0 ? owner(address) : "unknown-entry", hops };
+    }
+    struct loader_inputs { bool environment; bool renderer; };
+    inline loader_inputs observe_loader_inputs() noexcept {
+        error_scope preserve;
+        return { GetEnvironmentVariableW(L"SteamOverlayGameId", nullptr, 0) != 0,
+#ifdef _WIN64
+            GetModuleHandleW(L"GameOverlayRenderer64.dll") != nullptr };
+#else
+            GetModuleHandleW(L"GameOverlayRenderer.dll") != nullptr };
+#endif
+    }
+    inline void loader(bool use_load_library, bool enabled, loader_inputs inputs) noexcept {
+        error_scope preserve;
+        if (!once(1u)) return;
+        try { reshade::log::message(reshade::log::level::info,
+            "EGO_COMPATIBILITY_SNAPSHOT_V1 {\"schemaVersion\":1,\"runtimeGeneration\":31,\"kind\":\"loader\",\"pid\":%lu,\"tid\":%lu,\"strategy\":\"%s\",\"enabled\":%s,\"steamEnvironment\":%s,\"steamRenderer\":%s}",
+            GetCurrentProcessId(), GetCurrentThreadId(), use_load_library ? "load-library" : "notification", enabled ? "true" : "false", inputs.environment ? "true" : "false", inputs.renderer ? "true" : "false"); } catch (...) {}
+    }
+    inline unsigned factory_begin(unsigned flags, bool internal) noexcept {
+        error_scope preserve;
+        const unsigned ticket = discovery_depth != 0 ? 2u : internal ? 4u : 8u;
+        if (!once(ticket)) return 0;
+        try { reshade::log::message(reshade::log::level::info,
+            "EGO_COMPATIBILITY_SNAPSHOT_V1 {\"schemaVersion\":1,\"runtimeGeneration\":31,\"kind\":\"factory-entry\",\"pid\":%lu,\"tid\":%lu,\"ticket\":%u,\"flags\":%u,\"methodDiscovery\":%s,\"dxgiInternal\":%s}",
+            GetCurrentProcessId(), GetCurrentThreadId(), ticket, flags, discovery_depth != 0 ? "true" : "false", internal ? "true" : "false"); } catch (...) {}
+        return ticket;
+    }
+    inline void factory_result(unsigned ticket, HRESULT result, const void *original, const void *returned, const void *original_entry, const void *returned_entry) noexcept {
+        error_scope preserve;
+        if (ticket == 0) return;
+        try { reshade::log::message(reshade::log::level::info,
+            "EGO_COMPATIBILITY_SNAPSHOT_V1 {\"schemaVersion\":1,\"runtimeGeneration\":31,\"kind\":\"factory-return\",\"pid\":%lu,\"tid\":%lu,\"ticket\":%u,\"hresult\":%u,\"original\":\"%p\",\"returned\":\"%p\",\"originalCreateSwapChain\":\"%p\",\"originalOwner\":\"%s\",\"returnedCreateSwapChain\":\"%p\",\"returnedOwner\":\"%s\"}",
+            GetCurrentProcessId(), GetCurrentThreadId(), ticket, static_cast<unsigned>(result), original, returned, original_entry, owner(original_entry), returned_entry, owner(returned_entry)); } catch (...) {}
+    }
+    inline bool claim_present(bool proxy, bool extended, unsigned flags) noexcept {
+        // Four first non-TEST entries per host: proxy/raw times Present/Present1.
+        // This performs no observation or allocation after a role was emitted.
+        return (flags & 1u /* DXGI_PRESENT_TEST */) == 0 && discovery_depth == 0 && once(16u << ((proxy ? 0 : 2) + (extended ? 1 : 0)));
+    }
+    inline void callbacks(const char *kind, const char *role, const char *method, const void *instance, const void *downstream,
+        const void *device, const void *current, const void *target, const void *saved, bool internal) noexcept {
+        error_scope preserve;
+        const auto current_jump = observe_entry_jump(current), target_jump = observe_entry_jump(target), saved_jump = observe_entry_jump(saved);
+        try { reshade::log::message(reshade::log::level::info,
+            "EGO_COMPATIBILITY_SNAPSHOT_V1 {\"schemaVersion\":1,\"runtimeGeneration\":31,\"kind\":\"%s\",\"pid\":%lu,\"tid\":%lu,\"role\":\"%s\",\"method\":\"%s\",\"instance\":\"%p\",\"downstreamInstance\":\"%p\",\"device\":\"%p\",\"current\":\"%p\",\"currentOwner\":\"%s\",\"currentJumpOwner\":\"%s\",\"currentJumpHops\":%u,\"target\":\"%p\",\"targetOwner\":\"%s\",\"targetJumpOwner\":\"%s\",\"targetJumpHops\":%u,\"saved\":\"%p\",\"savedOwner\":\"%s\",\"savedJumpOwner\":\"%s\",\"savedJumpHops\":%u,\"dxgiInternal\":%s}",
+            kind, GetCurrentProcessId(), GetCurrentThreadId(), role, method, instance, downstream, device, current, owner(current), current_jump.owner, current_jump.hops, target, owner(target), target_jump.owner, target_jump.hops, saved, owner(saved), saved_jump.owner, saved_jump.hops, internal ? "true" : "false"); } catch (...) {}
+    }
+    inline void present_end(bool proxy, bool extended, HRESULT result) noexcept {
+        error_scope preserve;
+        try { reshade::log::message(reshade::log::level::info,
+            "EGO_COMPATIBILITY_SNAPSHOT_V1 {\"schemaVersion\":1,\"runtimeGeneration\":31,\"kind\":\"present-return\",\"pid\":%lu,\"tid\":%lu,\"role\":\"%s\",\"method\":\"%s\",\"hresult\":%u}",
+            GetCurrentProcessId(), GetCurrentThreadId(), proxy ? "proxy" : "raw", extended ? "Present1" : "Present", static_cast<unsigned>(result)); } catch (...) {}
+    }
+}
