+// Null-HWND inference only. A tooltip/tool popup must not displace the game's
+// input/presentation window. Preserve captioned tools, ordinary frameless tools
+// and an explicit APPWINDOW declaration; no class, title, size or owner guesses.
+inline bool presentation_candidate(HWND window) noexcept {
+    const error_scope preserve;
+    SetLastError(ERROR_SUCCESS);
+    const auto style=static_cast<DWORD>(GetWindowLongPtrW(window,GWL_STYLE));
+    if(style==0 && GetLastError()!=ERROR_SUCCESS) return false;
+    SetLastError(ERROR_SUCCESS);
+    const auto extended=static_cast<DWORD>(GetWindowLongPtrW(window,GWL_EXSTYLE));
+    if(extended==0 && GetLastError()!=ERROR_SUCCESS) return false;
+    const bool caption=(style & WS_CAPTION)==WS_CAPTION;
+    const bool tool_popup=(style & WS_POPUP)!=0 && (extended & WS_EX_TOOLWINDOW)!=0;
+    const bool explicitly_nonactivating=(extended & WS_EX_NOACTIVATE)!=0;
+    const bool layered_topmost=(extended & (WS_EX_LAYERED|WS_EX_TOPMOST))==(WS_EX_LAYERED|WS_EX_TOPMOST);
+    return !(tool_popup && !caption && (extended & WS_EX_APPWINDOW)==0 &&
+        (explicitly_nonactivating || layered_topmost));
+}
