+/*
+ * Explicit runtime membership for one HWND input manager.
+ * Mutating operations are serialized by input::_mutex. The current identity is
+ * opaque and never dereferenced; reads can also be made outside that mutex.
+ */
+#pragma once
+
+#include <atomic>
+#include <cassert>
+#include <cstddef>
+
+namespace reshade
+{
+    class input_frame_consumer
+    {
+    public:
+        struct release_result
+        {
+            bool current = false;
+            bool last = false;
+        };
+
+        void register_consumer() noexcept
+        {
+            ++_active_count;
+        }
+
+        bool acquire(const void *identity) noexcept
+        {
+            if (identity == nullptr || _active_count == 0)
+                return false;
+            // Every presenting runtime can make progress, even if the runtime
+            // which presented previously is still initialized but paused.
+            _current.store(identity, std::memory_order_release);
+            return true;
+        }
+
+        bool is_current(const void *identity) const noexcept
+        {
+            return identity != nullptr &&
+                _current.load(std::memory_order_acquire) == identity;
+        }
+
+        release_result unregister_consumer(const void *identity) noexcept
+        {
+            assert(_active_count != 0);
+            if (_active_count == 0)
+                return {};
+            const void *expected = identity;
+            release_result result;
+            result.current = _current.compare_exchange_strong(expected, nullptr,
+                std::memory_order_acq_rel, std::memory_order_acquire);
+            result.last = --_active_count == 0;
+            if (result.last)
+                _current.store(nullptr, std::memory_order_release);
+            return result;
+        }
+
+    private:
+        std::size_t _active_count = 0;
+        std::atomic<const void *> _current { nullptr };
+    };
+}
