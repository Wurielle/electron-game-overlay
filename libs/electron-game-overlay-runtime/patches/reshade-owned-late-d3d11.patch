diff --git a/source/ego_owned_late_d3d11/owned_config_file.hpp b/source/ego_owned_late_d3d11/owned_config_file.hpp
new file mode 100644
index 0000000..425720a
--- /dev/null
+++ b/source/ego_owned_late_d3d11/owned_config_file.hpp
@@ -0,0 +1,179 @@
+#pragma once
+
+#include <Windows.h>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+// Same-module file ownership only; none of these private C++ types is exported.
+namespace ego_owned_config
+{
+    struct identity
+    {
+        DWORD volume = 0, index_high = 0, index_low = 0;
+        FILETIME creation = {};
+        bool valid = false;
+    };
+
+    inline DWORD inspect(HANDLE file, identity &result)
+    {
+        BY_HANDLE_FILE_INFORMATION info = {};
+        if (!GetFileInformationByHandle(file, &info)) return GetLastError();
+        if (GetFileType(file) != FILE_TYPE_DISK || info.nNumberOfLinks != 1 ||
+            (info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) != 0)
+            return ERROR_ACCESS_DENIED;
+        result = { info.dwVolumeSerialNumber, info.nFileIndexHigh, info.nFileIndexLow, info.ftCreationTime, true };
+        return ERROR_SUCCESS;
+    }
+
+    inline bool same(const identity &a, const identity &b)
+    {
+        return a.valid && b.valid && a.volume == b.volume && a.index_high == b.index_high &&
+            a.index_low == b.index_low && a.creation.dwHighDateTime == b.creation.dwHighDateTime &&
+            a.creation.dwLowDateTime == b.creation.dwLowDateTime;
+    }
+
+    struct reserved_file
+    {
+        std::filesystem::path path;
+        identity created;
+        // Read-data access participates in Windows share checks and permits CRT
+        // SH_DENYWR saves. Metadata-only access would not block pathname rename.
+        // Withholding delete sharing protects every runtime config flush.
+        HANDLE guard = INVALID_HANDLE_VALUE;
+        bool deletion_phase = false;
+        reserved_file() = default;
+        reserved_file(const reserved_file &) = delete;
+        reserved_file &operator=(const reserved_file &) = delete;
+        ~reserved_file() { if (guard != INVALID_HANDLE_VALUE) CloseHandle(guard); }
+        bool owned() const noexcept { return created.valid && guard != INVALID_HANDLE_VALUE; }
+    };
+
+    struct temporary_handle
+    {
+        HANDLE value = INVALID_HANDLE_VALUE;
+        ~temporary_handle() { if (value != INVALID_HANDLE_VALUE) CloseHandle(value); }
+    };
+
+    inline DWORD write_seed(HANDLE file, const std::string &seed)
+    {
+        DWORD written = 0;
+        if (!seed.empty() && (!WriteFile(file, seed.data(), static_cast<DWORD>(seed.size()), &written, nullptr) ||
+            written != seed.size())) return ERROR_WRITE_FAULT;
+        return FlushFileBuffers(file) ? ERROR_SUCCESS : GetLastError();
+    }
+
+    // On a seed-write failure the exact owned record remains available for the
+    // caller's known-no-runtime cleanup; it is never silently abandoned.
+    template <typename Writer>
+    DWORD create_seeded(reserved_file &record, const std::filesystem::path &path,
+        const std::string &seed, Writer &&writer)
+    {
+        if (record.guard != INVALID_HANDLE_VALUE || record.created.valid || !path.is_absolute() ||
+            path.filename().wstring().find(L':') != std::wstring::npos)
+            return ERROR_INVALID_PARAMETER;
+        record.path = path; // Any allocation failure happens before CREATE_NEW.
+        record.deletion_phase = false;
+        temporary_handle file;
+        file.value = CreateFileW(path.c_str(), GENERIC_WRITE | FILE_READ_ATTRIBUTES,
+            FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, CREATE_NEW,
+            FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (file.value == INVALID_HANDLE_VALUE) return GetLastError();
+        record.guard = file.value; // Record ownership before identity/seed work.
+        file.value = INVALID_HANDLE_VALUE;
+        DWORD error = inspect(record.guard, record.created);
+        if (error != ERROR_SUCCESS) return error; // Retain unknown identity safely.
+        temporary_handle metadata;
+        metadata.value = CreateFileW(path.c_str(), FILE_READ_DATA | FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE,
+            nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (metadata.value == INVALID_HANDLE_VALUE) return GetLastError();
+        identity actual;
+        error = inspect(metadata.value, actual);
+        if (error != ERROR_SUCCESS || !same(actual, record.created)) return ERROR_FILE_INVALID;
+        error = writer(record.guard, seed);
+        // Use a separate read-only file object, rather than a reduced-access
+        // duplicate whose original write/delete share state can block CRT saves.
+        CloseHandle(record.guard);
+        record.guard = metadata.value;
+        metadata.value = INVALID_HANDLE_VALUE;
+        return error;
+    }
+
+    inline DWORD create_seeded(reserved_file &record, const std::filesystem::path &path, const std::string &seed)
+    {
+        return create_seeded(record, path, seed, write_seed);
+    }
+
+    inline DWORD verify_current(const reserved_file &record)
+    {
+        if (!record.owned()) return ERROR_INVALID_HANDLE;
+        identity pinned;
+        DWORD error = inspect(record.guard, pinned);
+        if (error != ERROR_SUCCESS || !same(pinned, record.created)) return ERROR_FILE_INVALID;
+        temporary_handle current;
+        current.value = CreateFileW(record.path.c_str(), FILE_READ_ATTRIBUTES,
+            FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (current.value == INVALID_HANDLE_VALUE) return GetLastError();
+        identity actual;
+        error = inspect(current.value, actual);
+        return error == ERROR_SUCCESS && same(actual, record.created) ? ERROR_SUCCESS : ERROR_FILE_INVALID;
+    }
+
+    // Call only after all runtime users are gone. Keep a permissive metadata
+    // handle to the original object while dropping its no-delete guard, so an
+    // object renamed/replaced in this small handoff cannot reuse its file ID.
+    inline DWORD begin_retirement(reserved_file &record)
+    {
+        if (record.deletion_phase) return record.owned() ? ERROR_SUCCESS : ERROR_INVALID_HANDLE;
+        DWORD error = verify_current(record);
+        if (error != ERROR_SUCCESS) return error;
+        temporary_handle handoff;
+        handoff.value = CreateFileW(record.path.c_str(), FILE_READ_ATTRIBUTES,
+            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+            FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (handoff.value == INVALID_HANDLE_VALUE) return GetLastError();
+        identity actual;
+        error = inspect(handoff.value, actual);
+        if (error != ERROR_SUCCESS || !same(actual, record.created)) return ERROR_FILE_INVALID;
+        CloseHandle(record.guard);
+        record.guard = handoff.value;
+        handoff.value = INVALID_HANDLE_VALUE;
+        record.deletion_phase = true;
+        return ERROR_SUCCESS;
+    }
+
+    template <typename ClearCache>
+    DWORD retire(reserved_file &record, ClearCache &&clear_exact_cache)
+    {
+        DWORD error = begin_retirement(record);
+        if (error != ERROR_SUCCESS) return error;
+        temporary_handle deletion;
+        const ULONGLONG deadline = GetTickCount64() + 20;
+        for (;;)
+        {
+            deletion.value = CreateFileW(record.path.c_str(), DELETE | FILE_READ_ATTRIBUTES,
+                FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+            if (deletion.value != INVALID_HANDLE_VALUE) break;
+            error = GetLastError();
+            // A concurrent stock INI flush briefly holds a CRT handle without
+            // delete sharing. The original object remains pinned by handoff;
+            // retry only this transient open failure, before any mutation.
+            if ((error != ERROR_SHARING_VIOLATION && error != ERROR_LOCK_VIOLATION) ||
+                GetTickCount64() >= deadline) return error;
+            Sleep(1);
+        }
+        identity actual;
+        error = inspect(deletion.value, actual);
+        if (error != ERROR_SUCCESS || !same(actual, record.created)) return ERROR_FILE_INVALID;
+        // The delete-capable handle denies replacement through cache eviction
+        // and handle-based deletion. Never delete a pathname after checking it.
+        FILE_DISPOSITION_INFO disposition { TRUE };
+        if (!SetFileInformationByHandle(deletion.value, FileDispositionInfo, &disposition, sizeof(disposition)))
+            return GetLastError();
+        clear_exact_cache(record.path);
+        CloseHandle(record.guard);
+        record.guard = INVALID_HANDLE_VALUE;
+        record.created.valid = false;
+        return ERROR_SUCCESS;
+    }
+}
diff --git a/source/ego_owned_late_d3d11/owned_late_d3d11.hpp b/source/ego_owned_late_d3d11/owned_late_d3d11.hpp
new file mode 100644
index 0000000..a5c732e
--- /dev/null
+++ b/source/ego_owned_late_d3d11/owned_late_d3d11.hpp
@@ -0,0 +1,67 @@
+#pragma once
+
+// Owned-host baseline only. Include exactly once from source/addon.cpp.
+#if !defined(RESHADE_OWNED_LATE_D3D11) && !defined(RESHADE_OWNED_LATE_D3D11_ABI_ONLY)
+#error Owned late D3D11 requires the explicit owned-host build switch.
+#endif
+
+#include <windows.h>
+#include <cstdint>
+#include <type_traits>
+
+#pragma pack(push, 8)
+struct ego_owned_late_d3d11_initialize_v1
+{
+    std::uint32_t struct_size;
+    std::uint32_t abi_version;
+    std::uint32_t flags; // V1 requires zero.
+    std::uint32_t reserved; // V1 requires zero.
+};
+
+struct ego_owned_late_d3d11_stats_v1
+{
+    std::uint32_t struct_size;
+    std::uint32_t abi_version;
+    std::uint32_t status; // 0 cold; 1 installing; 2 active; 3 failed/passive; 4 normal hooks only
+    std::uint32_t last_win32_error;
+    std::uint32_t last_hresult;
+    std::uint32_t reserved;
+    std::uint64_t present_calls;
+    std::uint64_t adoption_attempts;
+    std::uint64_t adoption_successes;
+    std::uint64_t notifier_rejections;
+    std::uint64_t automatic_proxy_skips;
+    std::uint64_t resize_calls;
+    std::uint64_t resize_successes;
+    std::uint64_t retirements;
+    std::uint64_t quarantines;
+    std::uint64_t render_failures;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(wchar_t) == 2);
+static_assert(sizeof(ego_owned_late_d3d11_initialize_v1) == 16);
+static_assert(sizeof(ego_owned_late_d3d11_stats_v1) == 104);
+static_assert(std::is_standard_layout_v<ego_owned_late_d3d11_initialize_v1>);
+static_assert(std::is_trivially_copyable_v<ego_owned_late_d3d11_initialize_v1>);
+static_assert(std::is_standard_layout_v<ego_owned_late_d3d11_stats_v1>);
+static_assert(std::is_trivially_copyable_v<ego_owned_late_d3d11_stats_v1>);
+
+// Caller verifies the exact owned host/stage and safely registers/initializes
+// the first cooperative adapter before this call, outside DllMain. Null selects
+// V1 defaults. Non-null requests contain no paths or target graphics pointers.
+#if !defined(RESHADE_OWNED_LATE_D3D11_ABI_ONLY)
+extern "C" __declspec(dllexport) const std::uint32_t ElectronGameOverlayOwnedLateD3D11AbiV1 = 1;
+extern "C" __declspec(dllexport) DWORD WINAPI ElectronGameOverlayInitializeOwnedLateD3D11V1(
+    const ego_owned_late_d3d11_initialize_v1 *request);
+extern "C" __declspec(dllexport) DWORD WINAPI ElectronGameOverlayQueryOwnedLateD3D11V1(
+    ego_owned_late_d3d11_stats_v1 *result);
+
+#if defined(_M_IX86)
+#pragma comment(linker, "/EXPORT:ElectronGameOverlayOwnedLateD3D11AbiV1=_ElectronGameOverlayOwnedLateD3D11AbiV1,DATA")
+#pragma comment(linker, "/EXPORT:ElectronGameOverlayInitializeOwnedLateD3D11V1=_ElectronGameOverlayInitializeOwnedLateD3D11V1@4")
+#pragma comment(linker, "/EXPORT:ElectronGameOverlayQueryOwnedLateD3D11V1=_ElectronGameOverlayQueryOwnedLateD3D11V1@4")
+#endif
+
+#include "owned_late_d3d11.inl"
+#endif
diff --git a/source/ego_owned_late_d3d11/owned_late_d3d11.inl b/source/ego_owned_late_d3d11/owned_late_d3d11.inl
new file mode 100644
index 0000000..40ed86d
--- /dev/null
+++ b/source/ego_owned_late_d3d11/owned_late_d3d11.inl
@@ -0,0 +1,892 @@
+// Owned ReShade baseline. Foreign/official hosts never activate this path.
+#include "reshade.hpp"
+#include "runtime.hpp"
+#include "addon_manager.hpp"
+#include "hook_manager.hpp"
+#include "ini_file.hpp"
+#include "com_ptr.hpp"
+#include "owned_config_file.hpp"
+#include "dxgi/dxgi_swapchain.hpp"
+#include <d3d11_4.h>
+#include <d3dcommon.h>
+#include <tlhelp32.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <cwchar>
+#include <filesystem>
+#include <iterator>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+
+extern thread_local bool g_in_dxgi_runtime;
+extern "C" const unsigned int ElectronGameOverlayReShadeHostAbi;
+extern "C" volatile LONG ElectronGameOverlayReShadeAddonGate;
+
+namespace ego_owned_late_d3d11
+{
+    namespace fs = std::filesystem;
+    constexpr std::uint32_t abi_version = 1;
+    constexpr wchar_t marker_name[] = L"electron-game-overlay-owned-runtime-v1.marker";
+    constexpr char marker_contents[] = "ELECTRON_GAME_OVERLAY_OWNED_RUNTIME_STAGE_V1\n";
+    constexpr LONG addon_gate_registered = 2, addon_gate_closed = 3;
+
+    std::mutex install_mutex;
+    std::mutex registry_mutex;
+    std::atomic<std::uint32_t> status { 0 }, last_error { ERROR_SUCCESS }, last_hresult { S_OK };
+    std::atomic<std::uint64_t> present_calls { 0 }, adoption_attempts { 0 }, adoption_successes { 0 };
+    std::atomic<std::uint64_t> notifier_rejections { 0 }, automatic_skips { 0 };
+    std::atomic<std::uint64_t> resize_calls { 0 }, resize_successes { 0 }, retirements { 0 };
+    std::atomic<std::uint64_t> quarantines { 0 }, render_failures { 0 };
+    thread_local unsigned native_depth = 0;
+    fs::path owned_stage;
+    std::string config_seed;
+    std::uint64_t process_creation_time = 0;
+    bool retained_addon_reference = false;
+    std::atomic<std::uint64_t> next_config { 0 };
+
+    struct depth_scope { depth_scope() { ++native_depth; } ~depth_scope() { --native_depth; } };
+    struct dxgi_scope
+    {
+        bool previous = g_in_dxgi_runtime;
+        dxgi_scope() { g_in_dxgi_runtime = true; }
+        ~dxgi_scope() { g_in_dxgi_runtime = previous; }
+    };
+    struct handle
+    {
+        HANDLE value = INVALID_HANDLE_VALUE;
+        ~handle() { if (value != INVALID_HANDLE_VALUE && value != nullptr) CloseHandle(value); }
+    };
+
+    struct context_scope
+    {
+        com_ptr<ID3D11Multithread> multithread;
+        bool entered = false;
+        explicit context_scope(ID3D11DeviceContext *context)
+        {
+            if (context != nullptr && SUCCEEDED(context->QueryInterface(&multithread)) &&
+                multithread->GetMultithreadProtected())
+            {
+                multithread->Enter();
+                entered = true;
+            }
+        }
+        ~context_scope()
+        {
+            if (entered) multithread->Leave();
+        }
+    };
+
+    enum class chain_phase { initializing, waiting_for_surface, ready, reset, rejected, retired, quarantined };
+    struct chain_state
+    {
+        std::recursive_mutex mutex;
+        void *identity = nullptr; // Numeric identity only; deliberately not AddRef'd.
+        std::atomic<bool> dead { false };
+        chain_phase phase = chain_phase::initializing;
+        com_ptr<ID3D11Device> device;
+        com_ptr<ID3D11DeviceContext> context;
+        void *context_identity = nullptr;
+        // Immutable after registry publication. Raw Presents on different chains
+        // may overlap even when the app itself never overlaps context commands.
+        std::shared_ptr<std::recursive_mutex> context_operation_gate;
+        reshade::api::effect_runtime *runtime = nullptr;
+        std::string owned_config_utf8;
+        ego_owned_config::reserved_file owned_config_file;
+        fs::path config_cache_key;
+        bool runtime_creation_uncertain = false;
+        HWND window = nullptr;
+        bool swapchain_event_live = false;
+        bool needs_final_removal = false;
+        bool still_drawing = false;
+        UINT notification_id = 0;
+    };
+    std::map<void *, std::shared_ptr<chain_state>> chains;
+
+    std::string utf8(const fs::path &path) { return path.u8string(); }
+
+    bool regular_file(const fs::path &path)
+    {
+        const DWORD attributes = GetFileAttributesW(path.c_str());
+        return attributes != INVALID_FILE_ATTRIBUTES &&
+            (attributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) == 0;
+    }
+
+    DWORD read_regular_file(const fs::path &path, std::string &bytes, DWORD limit)
+    {
+        if (!regular_file(path)) return ERROR_ACCESS_DENIED;
+        handle file;
+        file.value = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr,
+            OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+        if (file.value == INVALID_HANDLE_VALUE) return GetLastError();
+        BY_HANDLE_FILE_INFORMATION info = {};
+        if (!GetFileInformationByHandle(file.value, &info)) return GetLastError();
+        if (GetFileType(file.value) != FILE_TYPE_DISK ||
+            (info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) != 0 ||
+            info.nFileSizeHigh != 0 || info.nFileSizeLow > limit)
+            return ERROR_ACCESS_DENIED;
+        bytes.resize(info.nFileSizeLow);
+        DWORD read = 0;
+        if (info.nFileSizeLow != 0 &&
+            (!ReadFile(file.value, bytes.data(), info.nFileSizeLow, &read, nullptr) || read != info.nFileSizeLow))
+            return ERROR_READ_FAULT;
+        return ERROR_SUCCESS;
+    }
+
+    bool beneath(const fs::path &candidate, const fs::path &parent)
+    {
+        auto child = candidate.begin();
+        for (auto component = parent.begin(); component != parent.end(); ++component, ++child)
+            if (child == candidate.end() || _wcsicmp(child->c_str(), component->c_str()) != 0) return false;
+        return true;
+    }
+
+    DWORD module_path(HMODULE module, fs::path &path)
+    {
+        std::wstring name(32768, L'\0');
+        const DWORD length = GetModuleFileNameW(module, name.data(), static_cast<DWORD>(name.size()));
+        if (length == 0) return GetLastError();
+        if (length >= name.size()) return ERROR_INSUFFICIENT_BUFFER;
+        name.resize(length);
+        path = fs::path(std::move(name));
+        return ERROR_SUCCESS;
+    }
+
+    DWORD validate_owned_stage(HMODULE own_module)
+    {
+        if (ElectronGameOverlayReShadeHostAbi != 1) return ERROR_REVISION_MISMATCH;
+        fs::path dll, executable;
+        DWORD error = module_path(own_module, dll);
+        if (error != ERROR_SUCCESS) return error;
+        error = module_path(nullptr, executable);
+        if (error != ERROR_SUCCESS) return error;
+        std::error_code ec;
+        const fs::path base = fs::canonical(g_reshade_base_path, ec);
+        if (ec) return ERROR_PATH_NOT_FOUND;
+        const fs::path dll_parent = fs::canonical(dll.parent_path(), ec);
+        if (ec || _wcsicmp(base.c_str(), dll_parent.c_str()) != 0) return ERROR_ACCESS_DENIED;
+        const fs::path game_parent = fs::canonical(executable.parent_path(), ec);
+        if (ec || beneath(base, game_parent)) return ERROR_ACCESS_DENIED;
+        std::string marker;
+        error = read_regular_file(base / marker_name, marker, sizeof(marker_contents));
+        if (error != ERROR_SUCCESS) return error;
+        if (marker != marker_contents) return ERROR_ACCESS_DENIED;
+        if (!regular_file(base / L"ReShade.ini") || !regular_file(base / L".electron-game-overlay-run.json"))
+            return ERROR_ACCESS_DENIED;
+        error = read_regular_file(base / L"ReShade.ini", config_seed, 4 * 1024 * 1024);
+        if (error != ERROR_SUCCESS) return error;
+        FILETIME creation = {}, exit = {}, kernel = {}, user = {};
+        if (!GetProcessTimes(GetCurrentProcess(), &creation, &exit, &kernel, &user)) return GetLastError();
+        process_creation_time = (static_cast<std::uint64_t>(creation.dwHighDateTime) << 32) | creation.dwLowDateTime;
+        owned_stage = base;
+        return ERROR_SUCCESS;
+    }
+
+    DWORD reserve_seeded_config(ego_owned_config::reserved_file &file)
+    {
+        for (unsigned attempt = 0; attempt != 64; ++attempt)
+        {
+            const auto sequence = next_config.fetch_add(1) + 1;
+            if (sequence > UINT32_MAX) return ERROR_ARITHMETIC_OVERFLOW;
+            wchar_t name[32] = {};
+            swprintf_s(name, L"ego-late-%08lx-%08lx.ini", GetCurrentProcessId(), static_cast<unsigned long>(sequence));
+            const DWORD error = ego_owned_config::create_seeded(file, owned_stage / name, config_seed);
+            if (error == ERROR_FILE_EXISTS || error == ERROR_ALREADY_EXISTS) continue;
+            return error;
+        }
+        return ERROR_FILE_EXISTS;
+    }
+
+    // The caller holds the chain lock and has proved that no runtime can still
+    // refer to this generated config. Never evict a template or another chain.
+    DWORD retire_config(chain_state &state)
+    {
+        if (state.runtime != nullptr || state.runtime_creation_uncertain) return ERROR_BUSY;
+        if (state.owned_config_file.guard == INVALID_HANDLE_VALUE) return ERROR_SUCCESS;
+        return ego_owned_config::retire(state.owned_config_file, [&](const fs::path &owned_path) {
+            if (!state.config_cache_key.empty()) reshade::ini_file::clear_cache(state.config_cache_key);
+            // A normal failed public Create resolves the already absolute path
+            // identically, but never succeeded far enough to publish a runtime.
+            else reshade::ini_file::clear_cache(owned_path);
+        });
+    }
+
+    bool ready_word(HMODULE module, const char *name)
+    {
+        auto *const word = reinterpret_cast<volatile LONG *>(GetProcAddress(module, name));
+        if (word == nullptr) return false;
+        MEMORY_BASIC_INFORMATION memory = {};
+        if (VirtualQuery(const_cast<LONG *>(word), &memory, sizeof(memory)) != sizeof(memory) ||
+            memory.State != MEM_COMMIT || (memory.Protect & PAGE_GUARD) != 0 ||
+            (memory.Protect & (PAGE_READWRITE | PAGE_EXECUTE_READWRITE)) == 0)
+            return false;
+        return InterlockedCompareExchange(word, 0, 0) == 1;
+    }
+
+    bool cooperative_adapter_ready()
+    {
+        handle snapshot;
+        snapshot.value = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE | TH32CS_SNAPMODULE32, GetCurrentProcessId());
+        if (snapshot.value == INVALID_HANDLE_VALUE) return false;
+        MODULEENTRY32W entry = {};
+        entry.dwSize = sizeof(entry);
+        if (!Module32FirstW(snapshot.value, &entry)) return false;
+        do
+        {
+            HMODULE module = nullptr;
+            if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                    reinterpret_cast<LPCWSTR>(entry.modBaseAddr), &module)) continue;
+            struct module_reference { HMODULE value; ~module_reference() { FreeLibrary(value); } } reference { module };
+            const auto *const addon_abi = reinterpret_cast<const unsigned int *>(
+                GetProcAddress(module, "ElectronGameOverlayReShadeAddonAbi"));
+            if (addon_abi == nullptr || *addon_abi != 1) continue;
+            const bool has_adapter_word = GetProcAddress(module, "ElectronGameOverlayCooperativeAdapterReadyV1") != nullptr;
+            if (has_adapter_word ? ready_word(module, "ElectronGameOverlayCooperativeAdapterReadyV1") :
+                ready_word(module, "ElectronGameOverlayCooperativeReadyV1")) return true;
+        }
+        while (Module32NextW(snapshot.value, &entry));
+        return false;
+    }
+
+    void erase_if_current(const std::shared_ptr<chain_state> &state)
+    {
+        const std::lock_guard<std::mutex> lock(registry_mutex);
+        const auto it = chains.find(state->identity);
+        if (it != chains.end() && it->second.get() == state.get()) chains.erase(it);
+    }
+
+    com_ptr<ID3D11DeviceContext> retain_context(const std::shared_ptr<chain_state> &state)
+    {
+        const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+        return state->context;
+    }
+
+    void initialize_surface_events(chain_state &state, IDXGISwapChain *chain, bool resized)
+    {
+        auto *const surface = static_cast<reshade::runtime *>(state.runtime)->get_swapchain();
+        state.swapchain_event_live = true;
+        state.needs_final_removal = true;
+        reshade::invoke_addon_event<reshade::addon_event::init_swapchain>(surface, resized);
+        BOOL fullscreen = FALSE;
+        HMONITOR monitor = nullptr;
+        com_ptr<IDXGIOutput> output;
+        {
+            dxgi_scope original_scope;
+            chain->GetFullscreenState(&fullscreen, &output);
+            DXGI_OUTPUT_DESC desc = {};
+            if (output != nullptr && SUCCEEDED(output->GetDesc(&desc))) monitor = desc.Monitor;
+        }
+        reshade::invoke_addon_event<reshade::addon_event::set_fullscreen_state>(surface, fullscreen != FALSE, monitor);
+    }
+
+    void reset_surface_events(chain_state &state, bool resized)
+    {
+        if (state.runtime == nullptr) return;
+        auto *const runtime = static_cast<reshade::runtime *>(state.runtime);
+        runtime->on_reset(); // destroy_effect_runtime precedes destroy_swapchain.
+        if (!resized && state.needs_final_removal)
+        {
+            // A resize-only destroy does not release EGO's persistent chain
+            // ownership. Final removal remains mandatory after a failed resize.
+            state.needs_final_removal = false;
+            state.swapchain_event_live = false;
+            reshade::invoke_addon_event<reshade::addon_event::destroy_swapchain>(runtime->get_swapchain(), false);
+        }
+        else if (resized && state.swapchain_event_live)
+        {
+            state.swapchain_event_live = false;
+            reshade::invoke_addon_event<reshade::addon_event::destroy_swapchain>(runtime->get_swapchain(), true);
+        }
+    }
+
+    struct release_back_buffer_views
+    {
+        reshade::runtime *runtime;
+        ~release_back_buffer_views()
+        {
+            // The helper releases only native backbuffer RTVs. Runtime identity,
+            // resolved/effect textures, participant resources and input survive.
+            runtime->release_owned_late_d3d11_back_buffer_views();
+        }
+    };
+
+    bool attempt_manual_creation(chain_state &state, IDXGISwapChain *chain)
+    {
+        state.runtime_creation_uncertain = true;
+        const bool created = ReShadeCreateEffectRuntime(reshade::api::device_api::d3d11, state.device.get(),
+            state.context.get(), chain, state.owned_config_utf8.c_str(), &state.runtime);
+        state.runtime_creation_uncertain = false;
+        if (!created)
+        {
+            com_ptr<ID3D11Texture2D> buffer;
+            D3D11_TEXTURE2D_DESC desc = {};
+            const bool got_buffer = SUCCEEDED(chain->GetBuffer(0, IID_PPV_ARGS(&buffer))) && buffer != nullptr;
+            if (got_buffer) buffer->GetDesc(&desc);
+            const bool tiny = got_buffer && desc.Width <= 16 && desc.Height <= 16;
+            state.phase = tiny ? chain_phase::waiting_for_surface : chain_phase::rejected;
+            last_error.store(tiny ? ERROR_RETRY : ERROR_FUNCTION_FAILED);
+            if (!tiny)
+            {
+                const DWORD cleanup_error = retire_config(state);
+                if (cleanup_error != ERROR_SUCCESS)
+                {
+                    state.phase = chain_phase::quarantined;
+                    ++quarantines;
+                    last_error.store(cleanup_error);
+                }
+            }
+            return false;
+        }
+        state.config_cache_key = static_cast<reshade::runtime *>(state.runtime)->get_config_path();
+        if (state.config_cache_key != state.owned_config_file.path)
+        {
+            // Never delete or evict a path unexpectedly selected by the runtime.
+            state.phase = chain_phase::quarantined;
+            ++quarantines;
+            last_error.store(ERROR_FILE_INVALID);
+            return false;
+        }
+        // Public Create already emits init_effect_runtime. Supply the missing
+        // managed-surface event once before the first update. The public API's
+        // first-init order differs from a stock proxy; resize below matches it.
+        const release_back_buffer_views release_views { static_cast<reshade::runtime *>(state.runtime) };
+        initialize_surface_events(state, chain, false);
+        state.phase = chain_phase::ready;
+        ++adoption_successes;
+        return true;
+    }
+
+    // The only callback context is our own same-module C++ allocation. It never
+    // crosses a cooperative SDK boundary and is not interpreted by another DLL.
+    void CALLBACK destroyed(void *opaque) noexcept
+    {
+        std::unique_ptr<std::shared_ptr<chain_state>> cookie(static_cast<std::shared_ptr<chain_state> *>(opaque));
+        const auto state = *cookie;
+        state->dead.store(true, std::memory_order_release);
+        try
+        {
+            const auto context = retain_context(state);
+            context_scope context_lock(context.get());
+            const std::lock_guard<std::recursive_mutex> operation_lock(*state->context_operation_gate);
+            const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+            if (state->phase == chain_phase::quarantined) return;
+            // Never QI/GetDesc/GetBuffer/Release the destructing raw swapchain.
+            // REQUIRED integration: swapchain_impl::get_hwnd returns cached HWND.
+            // Only our audited staged EGO adapter callbacks may run in this proof.
+            if (state->runtime != nullptr)
+            {
+                // The runtime destructor saves its config. Keep the no-delete
+                // read-only guard through that save and all final callbacks.
+                const DWORD identity_error = ego_owned_config::verify_current(state->owned_config_file);
+                if (identity_error != ERROR_SUCCESS)
+                {
+                    state->phase = chain_phase::quarantined;
+                    ++quarantines;
+                    last_error.store(identity_error);
+                    return;
+                }
+                reset_surface_events(*state, false);
+                auto *const runtime = state->runtime;
+                state->runtime_creation_uncertain = true;
+                ReShadeDestroyEffectRuntime(runtime);
+                state->runtime = nullptr;
+                state->runtime_creation_uncertain = false;
+            }
+            const DWORD cleanup_error = retire_config(*state);
+            if (cleanup_error != ERROR_SUCCESS)
+            {
+                state->phase = chain_phase::quarantined;
+                ++quarantines;
+                last_error.store(cleanup_error);
+                return;
+            }
+            state->context.reset();
+            state->device.reset();
+            state->phase = chain_phase::retired;
+            ++retirements;
+            erase_if_current(state);
+        }
+        catch (...)
+        {
+            // Keep the existing registry entry and COM refs until target exit.
+            // Do not retry partially completed teardown or unload active hooks.
+            const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+            state->phase = chain_phase::quarantined;
+            ++quarantines;
+            last_error.store(ERROR_UNHANDLED_EXCEPTION);
+        }
+    }
+
+    bool automatically_managed(IDXGISwapChain *chain)
+    {
+        DXGISwapChain *proxy = nullptr;
+        UINT bytes = sizeof(proxy);
+        if (SUCCEEDED(chain->GetPrivateData(__uuidof(DXGISwapChain), &bytes, &proxy)) &&
+            bytes == sizeof(proxy) && proxy != nullptr)
+        {
+            ++automatic_skips;
+            return true;
+        }
+        return false;
+    }
+
+    std::shared_ptr<chain_state> find_chain(IDXGISwapChain *chain, bool permit_adoption)
+    {
+        // The shared DXGI implementations also receive D3D10/12 chains. Prove
+        // the actual D3D11 type and threading mode before any registry/cookie.
+        com_ptr<ID3D11Device> candidate_device;
+        if (FAILED(chain->GetDevice(IID_PPV_ARGS(&candidate_device))) || candidate_device == nullptr)
+            return {};
+        if ((candidate_device->GetCreationFlags() & D3D11_CREATE_DEVICE_SINGLETHREADED) != 0)
+        {
+            last_error.store(ERROR_NOT_SUPPORTED);
+            return {};
+        }
+        com_ptr<ID3D11DeviceContext> candidate_context;
+        candidate_device->GetImmediateContext(&candidate_context);
+        if (candidate_context == nullptr) return {};
+        com_ptr<IUnknown> context_identity;
+        if (FAILED(candidate_context->QueryInterface(&context_identity)) || context_identity == nullptr) return {};
+        DXGI_SWAP_CHAIN_DESC desc = {};
+        if (FAILED(chain->GetDesc(&desc))) return {};
+        com_ptr<IUnknown> identity;
+        if (FAILED(chain->QueryInterface(&identity)) || identity == nullptr) return {};
+        std::shared_ptr<chain_state> state;
+        {
+            const std::lock_guard<std::mutex> lock(registry_mutex);
+            const auto it = chains.find(identity.get());
+            if (it != chains.end()) return it->second;
+            if (!permit_adoption) return {};
+            state = std::make_shared<chain_state>();
+            state->identity = identity.get();
+            state->device = std::move(candidate_device);
+            state->context = std::move(candidate_context);
+            state->context_identity = context_identity.get();
+            for (const auto &entry : chains)
+                if (entry.second->context_identity == state->context_identity)
+                {
+                    state->context_operation_gate = entry.second->context_operation_gate;
+                    break;
+                }
+            if (!state->context_operation_gate)
+                state->context_operation_gate = std::make_shared<std::recursive_mutex>();
+            state->window = desc.OutputWindow;
+            chains.emplace(state->identity, state);
+        }
+        context_scope context_lock(state->context.get());
+        const std::lock_guard<std::recursive_mutex> operation_lock(*state->context_operation_gate);
+        const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+        struct creation_guard
+        {
+            std::shared_ptr<chain_state> state;
+            bool registered = false;
+            bool finished = false;
+            ~creation_guard()
+            {
+                if (finished) return;
+                // Failures before entering public Create have no runtime users.
+                // In particular seed-write and UTF-8 conversion failures must
+                // not orphan the already reserved file or its exact cache key.
+                DWORD cleanup_error = ERROR_UNHANDLED_EXCEPTION;
+                if (state->runtime == nullptr && !state->runtime_creation_uncertain)
+                {
+                    try { cleanup_error = retire_config(*state); }
+                    catch (...) {} // Preserve the exact record on uncertain cleanup.
+                }
+                if (cleanup_error == ERROR_SUCCESS)
+                {
+                    state->phase = chain_phase::rejected;
+                    if (!registered) erase_if_current(state);
+                    return;
+                }
+                state->phase = chain_phase::quarantined;
+                ++quarantines;
+                if (!registered) erase_if_current(state);
+            }
+        } creation { state };
+        ++adoption_attempts;
+        com_ptr<ID3DDestructionNotifier> notifier;
+        const HRESULT notifier_hr = chain->QueryInterface(&notifier);
+        if (FAILED(notifier_hr) || notifier == nullptr)
+        {
+            ++notifier_rejections;
+            last_hresult.store(static_cast<std::uint32_t>(notifier_hr));
+            state->phase = chain_phase::rejected;
+            erase_if_current(state);
+            creation.finished = true;
+            return {};
+        }
+        auto cookie = std::make_unique<std::shared_ptr<chain_state>>(state);
+        const HRESULT register_hr = notifier->RegisterDestructionCallback(destroyed, cookie.get(), &state->notification_id);
+        if (FAILED(register_hr))
+        {
+            ++notifier_rejections;
+            last_hresult.store(static_cast<std::uint32_t>(register_hr));
+            state->phase = chain_phase::rejected;
+            erase_if_current(state);
+            creation.finished = true;
+            return {};
+        }
+        cookie.release(); // The exactly-once destruction callback owns this cookie.
+        creation.registered = true;
+        notifier.reset(); // Holding this QI reference would keep the chain alive.
+        const DWORD config_error = reserve_seeded_config(state->owned_config_file);
+        if (config_error != ERROR_SUCCESS)
+        {
+            state->phase = chain_phase::rejected;
+            last_error.store(config_error);
+            const DWORD cleanup_error = retire_config(*state);
+            if (cleanup_error != ERROR_SUCCESS)
+            {
+                state->phase = chain_phase::quarantined;
+                ++quarantines;
+                last_error.store(cleanup_error);
+            }
+            creation.finished = true;
+            return state;
+        }
+        state->owned_config_utf8 = utf8(state->owned_config_file.path);
+        attempt_manual_creation(*state, chain);
+        creation.finished = true;
+        return state;
+    }
+
+    template <typename Native>
+    HRESULT present(IDXGISwapChain *chain, UINT flags, Native &&native)
+    {
+        ++present_calls;
+        if (status.load(std::memory_order_acquire) != 2 || g_in_dxgi_runtime || native_depth != 0 ||
+            (flags & DXGI_PRESENT_TEST) != 0 || automatically_managed(chain))
+            return native();
+        depth_scope scope;
+        std::shared_ptr<chain_state> state;
+        try
+        {
+            state = find_chain(chain, true);
+            if (state)
+            {
+                const auto context = retain_context(state);
+                context_scope context_lock(context.get());
+                const std::lock_guard<std::recursive_mutex> operation_lock(*state->context_operation_gate);
+                const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+                if (!state->dead.load(std::memory_order_acquire) && state->phase == chain_phase::ready &&
+                    !((flags & DXGI_PRESENT_DO_NOT_WAIT) != 0 && state->still_drawing))
+                {
+                    auto *const runtime = static_cast<reshade::runtime *>(state->runtime);
+                    // Establish cleanup before acquisition so partial acquire
+                    // failure or an update exception cannot pin the chain idle.
+                    const release_back_buffer_views release_views { runtime };
+                    if (runtime->acquire_owned_late_d3d11_back_buffer_views())
+                        ReShadeUpdateAndPresentEffectRuntime(state->runtime);
+                    else
+                    {
+                        ++render_failures;
+                        last_error.store(ERROR_FUNCTION_FAILED);
+                    }
+                }
+            }
+        }
+        catch (...)
+        {
+            ++render_failures;
+            last_error.store(ERROR_UNHANDLED_EXCEPTION);
+            if (state)
+            {
+                const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+                state->phase = chain_phase::quarantined;
+                ++quarantines;
+            }
+        }
+        HRESULT hr;
+        { dxgi_scope original_scope; hr = native(); }
+        if (state)
+        {
+            const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+            state->still_drawing = hr == DXGI_ERROR_WAS_STILL_DRAWING;
+            if (hr == DXGI_ERROR_DEVICE_REMOVED || hr == DXGI_ERROR_DEVICE_RESET)
+                state->phase = chain_phase::rejected;
+        }
+        last_hresult.store(static_cast<std::uint32_t>(hr));
+        return hr;
+    }
+
+    template <typename Native>
+    HRESULT resize(IDXGISwapChain *chain, Native &&native)
+    {
+        if (status.load(std::memory_order_acquire) != 2 || g_in_dxgi_runtime || native_depth != 0 ||
+            automatically_managed(chain))
+            return native();
+        depth_scope scope;
+        auto state = find_chain(chain, false);
+        if (!state) return native();
+        ++resize_calls;
+        const auto context = retain_context(state);
+        bool managed = false;
+        {
+            context_scope context_lock(context.get());
+            const std::lock_guard<std::recursive_mutex> operation_lock(*state->context_operation_gate);
+            const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+            if (!state->dead.load(std::memory_order_acquire) &&
+                (state->phase == chain_phase::ready || state->phase == chain_phase::reset ||
+                    state->phase == chain_phase::waiting_for_surface))
+            {
+                managed = true;
+                if (state->runtime != nullptr)
+                {
+                    try
+                    {
+                        reset_surface_events(*state, true);
+                        state->phase = chain_phase::reset;
+                    }
+                    catch (...)
+                    {
+                        state->phase = chain_phase::quarantined;
+                        ++quarantines;
+                        last_error.store(ERROR_UNHANDLED_EXCEPTION);
+                    }
+                }
+            }
+        }
+        if (!managed) return native();
+        HRESULT hr;
+        { dxgi_scope original_scope; hr = native(); }
+        {
+            context_scope context_lock(context.get());
+            const std::lock_guard<std::recursive_mutex> operation_lock(*state->context_operation_gate);
+            const std::lock_guard<std::recursive_mutex> lock(state->mutex);
+            if ((state->phase == chain_phase::reset || state->phase == chain_phase::waiting_for_surface) &&
+                (SUCCEEDED(hr) || hr == DXGI_ERROR_INVALID_CALL) && !state->dead.load(std::memory_order_acquire))
+            {
+                try
+                {
+                    if (state->runtime == nullptr)
+                    {
+                        if (attempt_manual_creation(*state, chain) && SUCCEEDED(hr)) ++resize_successes;
+                    }
+                    else
+                    {
+                        auto *const runtime = static_cast<reshade::runtime *>(state->runtime);
+                        const release_back_buffer_views release_views { runtime };
+                        initialize_surface_events(*state, chain, true);
+                        if (runtime->on_init())
+                        {
+                            state->phase = chain_phase::ready;
+                            if (SUCCEEDED(hr)) ++resize_successes;
+                        }
+                        else state->phase = chain_phase::reset;
+                    }
+                }
+                catch (...)
+                {
+                    state->phase = chain_phase::quarantined;
+                    ++quarantines;
+                    last_error.store(ERROR_UNHANDLED_EXCEPTION);
+                }
+            }
+        }
+        last_hresult.store(static_cast<std::uint32_t>(hr));
+        return hr;
+    }
+
+    HRESULT STDMETHODCALLTYPE raw_present(IDXGISwapChain *chain, UINT interval, UINT flags)
+    {
+        const auto original = reshade::hooks::call(raw_present);
+        return present(chain, flags, [&] { return original(chain, interval, flags); });
+    }
