+extern "C" __declspec(dllexport) DWORD WINAPI ElectronGameOverlayInitializeOwnedLateD3D11V1(
+    const ego_owned_late_d3d11_initialize_v1 *request)
+{
+    using namespace ego_owned_late_d3d11;
+    if (request != nullptr && (request->struct_size != sizeof(*request) || request->abi_version != abi_version ||
+        request->flags != 0 || request->reserved != 0))
+        return ERROR_INVALID_PARAMETER;
+    const std::lock_guard<std::mutex> lock(install_mutex);
+    const auto previous_status = status.load(std::memory_order_acquire);
+    if (previous_status == 2 || previous_status == 4) return ERROR_SUCCESS;
+    if (previous_status != 0) return last_error.load() != ERROR_SUCCESS ? last_error.load() : ERROR_INVALID_STATE;
+    try
+    {
+        HMODULE own_module = nullptr;
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                reinterpret_cast<LPCWSTR>(&ElectronGameOverlayInitializeOwnedLateD3D11V1), &own_module))
+            return GetLastError();
+        DWORD error = validate_owned_stage(own_module);
+        if (error != ERROR_SUCCESS) return error;
+        const LONG gate = InterlockedCompareExchange(&ElectronGameOverlayReShadeAddonGate, 0, 0);
+        if (gate != addon_gate_registered && gate != addon_gate_closed)
+            return gate == 1 ? ERROR_BUSY : ERROR_NOT_READY;
+        // A CLOSED gate can also mean automatic initialization raced the first
+        // external loader. Require callback-registration completion, not merely
+        // a capability export or an arbitrary caller's assertion of readiness.
+        if (!cooperative_adapter_ready()) return ERROR_NOT_READY;
+        HMODULE d3d11 = nullptr;
+        error = loaded_d3d11(d3d11);
+        if (error != ERROR_SUCCESS)
+        {
+            last_error.store(error);
+            status.store(4, std::memory_order_release);
+            return ERROR_SUCCESS;
+        }
+        status.store(1, std::memory_order_release);
+        std::array<void *, 4> targets {};
+        error = discover_native_methods(own_module, d3d11, targets);
+        if (error != ERROR_SUCCESS)
+        {
+            last_error.store(error);
+            status.store(4, std::memory_order_release);
+            return ERROR_SUCCESS;
+        }
+        // No context/state/runtime lock is held here. The caller has already
+        // completed external adapter registration and member initialization.
+        // The manager mutex makes this return completion-safe, including when
+        // another automatic device is performing first initialization.
+        reshade::load_addons();
+        retained_addon_reference = true; // Kept until authoritative target exit.
+        if (!reshade::addon_all_loaded)
+        {
+            last_error.store(ERROR_DLL_INIT_FAILED);
+            status.store(3, std::memory_order_release);
+            return ERROR_DLL_INIT_FAILED;
+        }
+        error = install_native_methods(targets);
+        last_error.store(error);
+        status.store(error == ERROR_SUCCESS ? 2 : 3, std::memory_order_release);
+        return error;
+    }
+    catch (...)
+    {
+        last_error.store(ERROR_UNHANDLED_EXCEPTION);
+        status.store(3, std::memory_order_release);
+        return ERROR_UNHANDLED_EXCEPTION;
+    }
+}
