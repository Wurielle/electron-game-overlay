+static DWORD read_stdin_exact(HANDLE input, void *output, DWORD size)
+{
+    if (input == nullptr || input == INVALID_HANDLE_VALUE || GetFileType(input) != FILE_TYPE_PIPE)
+        return ERROR_INVALID_HANDLE;
+    auto *bytes = static_cast<BYTE *>(output);
+    while (size != 0)
+    {
+        DWORD read = 0;
+        if (!ReadFile(input, bytes, size, &read, nullptr)) return GetLastError();
+        if (read == 0) return ERROR_HANDLE_EOF;
+        bytes += read;
+        size -= read;
+    }
+    return ERROR_SUCCESS;
+}
+
+static DWORD read_cache_policy(process_image_policy &policy)
+{
+    const HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+    uint32_t length = 0;
+    DWORD error = read_stdin_exact(input, &length, sizeof(length));
+    if (error != ERROR_SUCCESS) return error;
+    if (length == 0 || length > 262144) return ERROR_INVALID_DATA;
+    std::string utf8(length, '\0');
+    error = read_stdin_exact(input, utf8.data(), length);
+    return error == ERROR_SUCCESS ? parse_process_image_policy(utf8, policy) : error;
+}
+
+static DWORD read_cache_route(DWORD pid, uint64_t creation, ego_private_route_v2 &route)
+{
+    static_assert(sizeof(ego_private_route_v2) == 112);
+    const HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+    DWORD error = read_stdin_exact(input, &route, sizeof(route));
+    if (error != ERROR_SUCCESS) return error;
+    // The route is the final frame. Reject trailing bytes and early closes.
+    BYTE extra = 0;
+    DWORD received = 0;
+    if (ReadFile(input, &extra, 1, &received, nullptr))
+    {
+        if (received != 0) return ERROR_INVALID_DATA;
+    }
+    else if ((error = GetLastError()) != ERROR_BROKEN_PIPE)
+        return error;
+    if (route.struct_size != sizeof(route) || route.version != EGO_PRIVATE_ROUTE_VERSION ||
+        route.target_pid != pid || route.target_creation_time_100ns != creation || creation == 0 ||
+        route.producer_pid == 0 || route.producer_creation_time_100ns == 0 ||
+        route.input_capabilities != 0 || route.reserved != 0 || route.reserved2 != 0 || route.port == 0 ||
+        !std::all_of(std::begin(route.token_ascii), std::end(route.token_ascii), [](uint8_t value) {
+            return (value >= '0' && value <= '9') || (value >= 'a' && value <= 'f');
+        })) return ERROR_INVALID_DATA;
+    return ERROR_SUCCESS;
+}
