diff --git a/source/ego_owned_late_d3d11/owned_runtime_policy.hpp b/source/ego_owned_late_d3d11/owned_runtime_policy.hpp
new file mode 100644
--- /dev/null
+++ b/source/ego_owned_late_d3d11/owned_runtime_policy.hpp
@@ -0,0 +1,92 @@
+#pragma once
+#include <Windows.h>
+#include <atomic>
+#include <filesystem>
+#include <cwchar>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+// Enabled only after the native owned-stage marker, canonical module/base path,
+// exact target context and seed have passed the existing validation boundary.
+namespace ego_owned_runtime_policy {
+inline std::atomic<bool> active { false };
+inline std::atomic<std::uintptr_t> next_cookie { 0 };
+inline std::mutex binding_mutex;
+inline constexpr wchar_t property_name[] = L"ElectronGameOverlay.OwnedCompositionWindowV1";
+struct error_scope { DWORD value = GetLastError(); ~error_scope() { SetLastError(value); } };
+struct window_binding {
+    mutable HWND window = nullptr;
+    mutable DWORD thread = 0;
+    mutable HANDLE cookie = nullptr;
+    HWND resolve() const noexcept {
+        error_scope preserve;
+        if (!active.load(std::memory_order_acquire)) return nullptr;
+        try {
+        const std::scoped_lock lock(binding_mutex);
+        struct inventory { DWORD pid; HWND window; unsigned count; } found { GetCurrentProcessId(), nullptr, 0 };
+        const BOOL complete = EnumWindows([](HWND candidate, LPARAM opaque) -> BOOL {
+            auto &found = *reinterpret_cast<inventory *>(opaque);
+            DWORD pid = 0;
+            if (GetWindowThreadProcessId(candidate, &pid) != 0 && pid == found.pid &&
+                IsWindowVisible(candidate) && GetAncestor(candidate, GA_ROOT) == candidate) {
+                found.window = candidate;
+                if (++found.count > 1) return FALSE;
+            }
+            return TRUE;
+        }, reinterpret_cast<LPARAM>(&found));
+        // No foreground, size, class-name, title or helper-name preference.
+        if (!complete || found.count != 1) return nullptr;
+        DWORD pid = 0;
+        const DWORD current_thread = GetWindowThreadProcessId(found.window, &pid);
+        if (pid != found.pid || current_thread == 0 || !IsWindowVisible(found.window)) return nullptr;
+        if (window != nullptr) {
+            // A swapchain never migrates to another window or a reused HWND.
+            return found.window == window && current_thread == thread &&
+                GetPropW(window, property_name) == cookie ? window : nullptr;
+        }
+        HANDLE token = GetPropW(found.window, property_name);
+        if (token == nullptr) {
+            auto value = next_cookie.load(std::memory_order_relaxed);
+            while (value != (std::numeric_limits<std::uintptr_t>::max)() &&
+                !next_cookie.compare_exchange_weak(value, value + 1, std::memory_order_relaxed)) {}
+            if (value == (std::numeric_limits<std::uintptr_t>::max)()) return nullptr;
+            token = reinterpret_cast<HANDLE>(value + 1);
+            if (!SetPropW(found.window, property_name, token)) return nullptr;
+        }
+        DWORD again_pid = 0;
+        if (GetWindowThreadProcessId(found.window, &again_pid) != current_thread || again_pid != found.pid ||
+            !IsWindowVisible(found.window) || GetPropW(found.window, property_name) != token) return nullptr;
+        window = found.window; thread = current_thread; cookie = token;
+        return window;
+        } catch (...) { return nullptr; }
+    }
+};
+inline bool immutable_configuration(const std::filesystem::path &file, const std::filesystem::path &stage) {
+    if (!active.load(std::memory_order_acquire) ||
+        _wcsicmp(file.parent_path().lexically_normal().c_str(), stage.lexically_normal().c_str()) != 0 ||
+        _wcsicmp(file.extension().c_str(), L".ini") != 0) return false;
+    const auto name = file.stem().wstring();
+    if (_wcsicmp(name.c_str(), L"ReShadePreset") == 0) return true;
+    size_t offset = 0;
+    if (_wcsnicmp(name.c_str(), L"ReShade", 7) == 0) {
+        offset = 7;
+        if (_wcsnicmp(name.c_str() + offset, L"VR", 2) == 0) offset += 2;
+        if (offset == name.size()) return true;
+        if (name.size() - offset > 3 || name[offset] == L'0') return false;
+        unsigned ordinal = 0;
+        for (; offset < name.size(); ++offset) {
+            if (name[offset] < L'0' || name[offset] > L'9') return false;
+            ordinal = ordinal * 10 + unsigned(name[offset] - L'0');
+        }
+        return ordinal >= 2 && ordinal <= 100;
+    }
+    if (name.size() == 26 && name.compare(0, 9, L"ego-late-") == 0 && name[17] == L'-') {
+        for (size_t i = 9; i < name.size(); ++i) {
+            if (i == 17) continue;
+            if (!((name[i] >= L'0' && name[i] <= L'9') || (name[i] >= L'a' && name[i] <= L'f'))) return false;
+        }
+        return true;
+    }
+    return false;
+}
+}
