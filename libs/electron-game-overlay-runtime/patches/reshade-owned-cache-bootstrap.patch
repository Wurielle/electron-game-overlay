+namespace
+{
+	std::string owned_cache_configuration;
+
+	bool configure_owned_cache()
+	{
+		using namespace ego::runtime_cache;
+		const auto runtime_path = L"\\\\?\\" + std::wstring(dos_path(g_reshade_dll_path.native()));
+		const HANDLE runtime = CreateFileW(runtime_path.c_str(), FILE_READ_ATTRIBUTES, FILE_SHARE_READ,
+			nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+		if (runtime == INVALID_HANDLE_VALUE) return false;
+		file_identity identity;
+		const auto identity_error = read_identity(runtime, identity);
+		CloseHandle(runtime);
+		if (identity_error != ERROR_SUCCESS) return false;
+
+		const DWORD pid = GetCurrentProcessId();
+		std::uint64_t birth = 0;
+		if (creation_time(GetCurrentProcess(), birth) != ERROR_SUCCESS) return false;
+		const HANDLE mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, host_claim_name(pid, birth).c_str());
+		if (mapping == nullptr) return false;
+		HANDLE log = nullptr;
+		const auto bootstrap_error = read_bootstrap(mapping, pid, birth, identity, owned_cache_configuration, log);
+		CloseHandle(mapping);
+		if (bootstrap_error != ERROR_SUCCESS) return false;
+		g_reshade_base_path = g_reshade_dll_path.parent_path();
+		if (!reshade::ini_file::reserve_memory_cache(g_reshade_base_path / L"ReShade.ini", owned_cache_configuration)) return false;
+		if (log != nullptr) reshade::log::adopt_log_file(log);
+		return true;
+	}
+}
+
+std::string_view ego::runtime_cache::owned_configuration_seed() noexcept
+{
+	return owned_cache_configuration;
+}
