+	// Serialize the first normal add-on-manager initialization with the one
+	// project-owned external add-on load that may have claimed the gate. This
+	// closes registration before event vectors can be iterated, while allowing
+	// an already-claimed LoadLibrary call to finish registering from DllMain.
+	for (;;)
+	{
+		const LONG state = InterlockedCompareExchange(
+			&ElectronGameOverlayReShadeAddonGate,
+			electron_game_overlay_addon_gate_closed,
+			electron_game_overlay_addon_gate_open);
+		if (state == electron_game_overlay_addon_gate_open ||
+			state == electron_game_overlay_addon_gate_closed)
+			break;
+		if (state == electron_game_overlay_addon_gate_registered)
+		{
+			if (InterlockedCompareExchange(
+					&ElectronGameOverlayReShadeAddonGate,
+					electron_game_overlay_addon_gate_closed,
+					electron_game_overlay_addon_gate_registered) ==
+				electron_game_overlay_addon_gate_registered)
+				break;
+			continue;
+		}
+
+		// The external loader owns the registration vectors until it publishes
+		// either REGISTERED or OPEN. Do not begin normal initialization midway
+		// through its DllMain callbacks.
+		SwitchToThread();
+	}
+
 	ini_file &config = global_config();
 
 	addon_all_loaded = true;
