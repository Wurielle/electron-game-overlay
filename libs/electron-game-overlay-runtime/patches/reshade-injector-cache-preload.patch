+static bool inspect_reshade_config_text(const std::wstring &config_text,
+	target_effective_reshade_settings &settings, DWORD &error)
+{
+	bool addon_path_found = false;
+	std::vector<std::wstring> addon_path_values;
+	if (!find_ini_values(
+			config_text,
+			L"ADDON",
+			L"AddonPath",
+			addon_path_found,
+			addon_path_values,
+			error))
+		return false;
+
+	std::wstring addon_directory = settings.reshade_base_path;
+	if (addon_path_found &&
+		!addon_path_values.empty() &&
+		!addon_path_values.front().empty())
+	{
+		addon_directory = addon_path_values.front();
+		if (!is_absolute_windows_path(addon_directory))
+			addon_directory =
+				settings.reshade_base_path +
+				L"\\" +
+				addon_directory;
+	}
+	if (!get_full_path(
+		addon_directory,
+		settings.addon_directory_path,
+		error))
+		return false;
+
+	bool disabled_addons_found = false;
+	std::vector<std::wstring> disabled_addons;
+	if (!find_ini_values(
+			config_text,
+			L"ADDON",
+			L"DisabledAddons",
+			disabled_addons_found,
+			disabled_addons,
+			error))
+		return false;
+	if (disabled_addons_found)
+	{
+		settings.disabled_addons = disabled_addons;
+		constexpr wchar_t addon_name[] =
+			L"Electron Game Overlay Runtime";
+		constexpr const wchar_t *addon_file =
+			target_electron_overlay_addon_file;
+		const std::wstring name_and_file =
+			std::wstring(addon_name) + L"@" + addon_file;
+		const std::wstring file_only =
+			std::wstring(L"@") + addon_file;
+		for (const std::wstring &disabled_addon : disabled_addons)
+		{
+			if (disabled_addon == addon_name ||
+				disabled_addon == file_only ||
+				disabled_addon == name_and_file)
+			{
+				settings.electron_game_overlay_addon_disabled = true;
+				break;
+			}
+		}
+	}
+
+	return true;
+}
+
+static bool inspect_cache_seed(std::string_view seed, const std::wstring &directory,
+	target_effective_reshade_settings &settings, DWORD &error)
+{
+	std::wstring text;
+	const std::vector<BYTE> bytes(seed.begin(), seed.end());
+	settings = {};
+	settings.reshade_base_path = directory;
+	return decode_utf8_text(bytes, text, error) && inspect_reshade_config_text(text, settings, error);
+}
+
+static bool inspect_mapped_cache_config(HANDLE process, const std::wstring &runtime,
+	const std::wstring &directory, target_effective_reshade_settings &settings, DWORD &error)
+{
+	using namespace ego::runtime_cache;
+	uint64_t birth = 0;
+	const DWORD pid = GetProcessId(process);
+	error = creation_time(process, birth);
+	if (error != ERROR_SUCCESS || pid == 0) return false;
+	handle image;
+	file_identity identity;
+	error = open_pinned(std::wstring(dos_path(runtime)), false, image);
+	if (error == ERROR_SUCCESS) error = read_identity(image.value, identity);
+	if (error != ERROR_SUCCESS) return false;
+	const scoped_handle mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, ego::runtime_cache::host_claim_name(pid, birth).c_str());
+	if (mapping == nullptr) { error = GetLastError(); return false; }
+	const void *view = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(bootstrap_header) + max_config_bytes);
+	if (view == nullptr) { error = GetLastError(); return false; }
+	bootstrap_header header;
+	memcpy(&header, view, sizeof(header));
+	const bool matches = header.magic == bootstrap_magic && header.version == 2 && header.struct_size == sizeof(header) &&
+		header.target_pid == pid && header.target_creation_time == birth && header.reserved == 0 && same_file(header.runtime, identity) &&
+		header.config_bytes > 0 && header.config_bytes <= max_config_bytes;
+	std::string seed;
+	if (matches) seed.assign(static_cast<const char *>(view) + sizeof(header), header.config_bytes);
+	UnmapViewOfFile(view);
+	if (!matches || !valid_seed(seed)) { error = ERROR_INVALID_DATA; return false; }
+	return inspect_cache_seed(seed, std::wstring(dos_path(directory)), settings, error);
+}
