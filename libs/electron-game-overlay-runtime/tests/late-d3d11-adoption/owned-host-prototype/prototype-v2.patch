+#if defined(RESHADE_OWNED_LATE_D3D11_PROTOTYPE)
+bool reshade::runtime::acquire_owned_late_d3d11_back_buffer_views()
+{
+	if (!_is_initialized || _device->get_api() != api::device_api::d3d11)
+		return false;
+	const size_t prefix = _back_buffer_resolved != 0 ? 2 : 0;
+	const uint32_t count = _swapchain->get_back_buffer_count();
+	if (count == 0 || count > 16 || _back_buffer_targets.size() < prefix)
+		return false;
+	if (_back_buffer_targets.size() == prefix + count * 2)
+		return true;
+	if (_back_buffer_targets.size() != prefix)
+		return false;
+
+	for (uint32_t index = 0; index < count; ++index)
+	{
+		const api::resource resource = _swapchain->get_back_buffer(index);
+		if (resource == 0)
+		{
+			release_owned_late_d3d11_back_buffer_views();
+			return false;
+		}
+		const auto desc = _device->get_resource_desc(resource);
+		if (desc.type != api::resource_type::texture_2d || desc.texture.width != _width ||
+			desc.texture.height != _height || desc.texture.samples != _back_buffer_samples)
+		{
+			release_owned_late_d3d11_back_buffer_views();
+			return false;
+		}
+		for (int srgb = 0; srgb != 2; ++srgb)
+		{
+			api::resource_view view = {};
+			if (!_device->create_resource_view(resource, api::resource_usage::render_target,
+					api::resource_view_desc(desc.texture.samples > 1 ?
+						api::resource_view_type::texture_2d_multisample : api::resource_view_type::texture_2d,
+						api::format_to_default_typed(desc.texture.format, srgb), 0, 1, 0, 1), &view))
+			{
+				release_owned_late_d3d11_back_buffer_views();
+				return false;
+			}
+			_back_buffer_targets.push_back(view);
+		}
+	}
+	return true;
+}
+
+void reshade::runtime::release_owned_late_d3d11_back_buffer_views()
+{
+	if (_device->get_api() != api::device_api::d3d11)
+		return;
+	// Resolved targets refer to our own texture, not to a native swap-chain
+	// backbuffer. Keep that prefix and every effect/GUI/input resource intact.
+	const size_t prefix = _back_buffer_resolved != 0 ? 2 : 0;
+	if (_back_buffer_targets.size() < prefix)
+		return;
+	for (size_t index = prefix; index < _back_buffer_targets.size(); ++index)
+		if (_back_buffer_targets[index] != 0)
+			_device->destroy_resource_view(_back_buffer_targets[index]);
+	const bool released_views = _back_buffer_targets.size() != prefix;
+	_back_buffer_targets.resize(prefix);
+	if (released_views)
+		// D3D11 destruction can be deferred. Flush after releasing our views,
+		// without clearing or replacing the application's restored bindings.
+		_graphics_queue->flush_immediate_command_list();
+}
