# One new pristine source file, independently atomic over the frozen gen-28 tree.
function(ego_d3d11_identity_source_tail source_dir direction)
    set(relative_path "source/dxgi/dxgi_swapchain.cpp")
    set(pristine_hash "4C422B53C413960D05BE9BE58DB70840AE9DB87873727CFE6DA6E04FF0EFA6A9")
    set(fixed_hash "A3152E13EF9651AF6406460AF605AD950D6A9867D2C7D4A2CC12835A32AD848A")
    ego_read_source_cache_file("${CMAKE_CURRENT_SOURCE_DIR}/patches" "reshade-d3d11-swapchain-resource-identity.patch" patch_hash patch_text)
    if(NOT patch_hash STREQUAL "25DA093F15FAACF74AA16ED0BFFA233B58D10C7FC1BEA15B667C0E9F5F6AAEF2")
        message(FATAL_ERROR "The D3D11 resource identity patch changed; source was not modified.")
    endif()
    ego_read_source_cache_file("${source_dir}" "${relative_path}" actual_hash source_text)
    if(NOT actual_hash STREQUAL pristine_hash AND NOT actual_hash STREQUAL fixed_hash)
        message(FATAL_ERROR "Unknown D3D11 identity source; edits were preserved.")
    endif()
    if(direction STREQUAL "REVERSE")
        if(actual_hash STREQUAL pristine_hash)
            return() # Historical cache validation remains authoritative.
        endif()
        set(result_hash "${pristine_hash}")
        set(apply_direction "--reverse")
    elseif(direction STREQUAL "FORWARD")
        set(result_hash "${fixed_hash}")
        set(apply_direction)
    else()
        message(FATAL_ERROR "Unknown D3D11 identity patch direction.")
    endif()
    set(RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256 "${RESHAPE_ELEVATED_PRIVATE_PATCHED_CONTENT_SHA256}" "${relative_path}=${actual_hash}")
    if(actual_hash STREQUAL fixed_hash)
        list(APPEND RESHAPE_EXPECTED_PATCHED_FILES "${relative_path}")
    endif()
    ego_assert_source_cache_vector("${source_dir}" ${RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256})
    verify_reshade_patched_source("${source_dir}")
    if(actual_hash STREQUAL result_hash)
        return()
    endif()
    set(scratch "${CMAKE_CURRENT_BINARY_DIR}/ego-d3d11-identity-stage")
    file(MAKE_DIRECTORY "${scratch}/candidate/source/dxgi")
    ego_write_lf_source_cache_file("${scratch}/candidate/${relative_path}" "${source_text}")
    ego_write_lf_source_cache_file("${scratch}/identity.patch" "${patch_text}")
    foreach(argument IN ITEMS "--check" "--apply")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
            "GIT_CEILING_DIRECTORIES=${scratch}" "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.eol=lf
            apply --whitespace=nowarn ${apply_direction} "${argument}" "${scratch}/identity.patch"
            WORKING_DIRECTORY "${scratch}/candidate" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    ego_read_source_cache_file("${scratch}/candidate" "${relative_path}" staged_hash ignored)
    if(NOT staged_hash STREQUAL result_hash)
        message(FATAL_ERROR "Unexpected staged D3D11 identity source hash; live source was preserved.")
    endif()
    ego_assert_source_cache_vector("${source_dir}" ${RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256})
    verify_reshade_patched_source("${source_dir}")
    file(RENAME "${scratch}/candidate/${relative_path}" "${source_dir}/${relative_path}" RESULT result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Unable to publish the verified D3D11 identity source: ${result}")
    endif()
    if(result_hash STREQUAL fixed_hash)
        if(NOT relative_path IN_LIST RESHAPE_EXPECTED_PATCHED_FILES)
            list(APPEND RESHAPE_EXPECTED_PATCHED_FILES "${relative_path}")
        endif()
    else()
        list(REMOVE_ITEM RESHAPE_EXPECTED_PATCHED_FILES "${relative_path}")
    endif()
    set(RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256 "${RESHAPE_ELEVATED_PRIVATE_PATCHED_CONTENT_SHA256}" "${relative_path}=${result_hash}")
    verify_reshade_patched_source("${source_dir}")
endfunction()
