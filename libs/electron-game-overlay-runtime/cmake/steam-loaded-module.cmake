# One new pristine source file, independently atomic over the generation-30 diagnostic tree.
function(ego_steam_loaded_module_source_tail source_dir direction)
    set(relative_path "source/hook_manager.cpp")
    set(pristine_hash "6249F7A92507B0AE9FF67843EDE673361698720982953E982C90466FB017F85E")
    set(fixed_hash "D3DF8D3B7A1B5762579F9813EF90BA9087D8647BC8333CD0E786E1526A9A8126")
    ego_read_source_cache_file("${CMAKE_CURRENT_SOURCE_DIR}/patches" "reshade-steam-loaded-module-hook-order.patch" patch_hash patch_text)
    if(NOT patch_hash STREQUAL "560BF8A6DB17643F7FA095F75FDBE0677211FC4354BEB6C869C7D4ECD7DB1241")
        message(FATAL_ERROR "The Steam loaded-module patch changed; source was not modified.")
    endif()
    ego_read_source_cache_file("${source_dir}" "${relative_path}" actual_hash source_text)
    if(NOT actual_hash STREQUAL pristine_hash AND NOT actual_hash STREQUAL fixed_hash)
        message(FATAL_ERROR "Unknown Steam loaded-module source; edits were preserved.")
    endif()
    if(direction STREQUAL "REVERSE")
        if(actual_hash STREQUAL pristine_hash)
            return() # Historical cache validation remains authoritative.
        endif()
        set(result_hash "${pristine_hash}")
        set(apply_direction "--reverse")
    elseif(direction STREQUAL "FORWARD")
        set(result_hash "${fixed_hash}")
        set(apply_direction)
    else()
        message(FATAL_ERROR "Unknown Steam loaded-module patch direction.")
    endif()
    set(RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256 "${RESHAPE_ELEVATED_PRIVATE_PATCHED_CONTENT_SHA256}" "source/dxgi/dxgi_swapchain.cpp=A3152E13EF9651AF6406460AF605AD950D6A9867D2C7D4A2CC12835A32AD848A" "${relative_path}=${actual_hash}")
    string(REPLACE "tools/injector.cpp=${RESHAPE_ELEVATED_PRIVATE_INJECTOR_CONTENT_SHA256}"
        "tools/injector.cpp=7A6DC34363FF8EBD78484D8AEE6CE0463F22E90AB35DD1261FC9FBD9B09A3A3E"
        RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256 "${RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256}")
    if(NOT "source/dxgi/dxgi_swapchain.cpp" IN_LIST RESHAPE_EXPECTED_PATCHED_FILES)
        list(APPEND RESHAPE_EXPECTED_PATCHED_FILES "source/dxgi/dxgi_swapchain.cpp")
    endif()
    if(actual_hash STREQUAL fixed_hash)
        list(APPEND RESHAPE_EXPECTED_PATCHED_FILES "${relative_path}")
    endif()
    ego_assert_source_cache_vector("${source_dir}" ${RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256})
    verify_reshade_patched_source("${source_dir}")
    if(actual_hash STREQUAL result_hash)
        return()
    endif()
    set(scratch "${CMAKE_CURRENT_BINARY_DIR}/ego-steam-loaded-module-stage")
    file(MAKE_DIRECTORY "${scratch}/candidate/source")
    ego_write_lf_source_cache_file("${scratch}/candidate/${relative_path}" "${source_text}")
    ego_write_lf_source_cache_file("${scratch}/steam.patch" "${patch_text}")
    foreach(argument IN ITEMS "--check" "--apply")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
            "GIT_CEILING_DIRECTORIES=${scratch}" "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.eol=lf
            apply --whitespace=nowarn ${apply_direction} "${argument}" "${scratch}/steam.patch"
            WORKING_DIRECTORY "${scratch}/candidate" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    ego_read_source_cache_file("${scratch}/candidate" "${relative_path}" staged_hash ignored)
    if(NOT staged_hash STREQUAL result_hash)
        message(FATAL_ERROR "Unexpected staged Steam loaded-module source hash; live source was preserved.")
    endif()
    ego_assert_source_cache_vector("${source_dir}" ${RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256})
    verify_reshade_patched_source("${source_dir}")
    file(RENAME "${scratch}/candidate/${relative_path}" "${source_dir}/${relative_path}" RESULT result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Unable to publish the verified Steam loaded-module source: ${result}")
    endif()
    if(result_hash STREQUAL fixed_hash)
        if(NOT relative_path IN_LIST RESHAPE_EXPECTED_PATCHED_FILES)
            list(APPEND RESHAPE_EXPECTED_PATCHED_FILES "${relative_path}")
        endif()
    else()
        list(REMOVE_ITEM RESHAPE_EXPECTED_PATCHED_FILES "${relative_path}")
    endif()
    set(RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256 "${RESHAPE_ELEVATED_PRIVATE_PATCHED_CONTENT_SHA256}" "source/dxgi/dxgi_swapchain.cpp=A3152E13EF9651AF6406460AF605AD950D6A9867D2C7D4A2CC12835A32AD848A" "${relative_path}=${result_hash}")
    string(REPLACE "tools/injector.cpp=${RESHAPE_ELEVATED_PRIVATE_INJECTOR_CONTENT_SHA256}"
        "tools/injector.cpp=7A6DC34363FF8EBD78484D8AEE6CE0463F22E90AB35DD1261FC9FBD9B09A3A3E"
        RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256 "${RESHAPE_EXPECTED_PATCHED_CONTENT_SHA256}")
    verify_reshade_patched_source("${source_dir}")
endfunction()
