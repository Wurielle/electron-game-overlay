{
  "name": "electron-game-overlay",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/electron-game-overlay/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["electron-game-overlay-runtime"],
  "// targets": "to see all targets run: nx show project electron-game-overlay --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "options": {
        "cwd": "libs/electron-game-overlay",
        "commands": [
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/clean-dist.ps1",
          "tsc --build tsconfig.lib.json",
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-game-overlay-runtime.ps1 -Architecture x64",
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-game-overlay-runtime.ps1 -Architecture x86"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "libs/electron-game-overlay",
        "command": "node --test tests/*.test.cjs"
      }
    }
  }
}
