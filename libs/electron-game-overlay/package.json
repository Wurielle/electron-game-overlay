{
  "name": "electron-game-overlay",
  "version": "0.1.0-rc.7",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "gelectron": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./broker": {
      "types": "./dist/broker.d.ts",
      "require": "./dist/broker.js",
      "import": "./dist/broker.js",
      "default": "./dist/broker.js"
    },
    "./packaging": {
      "types": "./dist/packaging.d.ts",
      "require": "./dist/packaging.js",
      "default": "./dist/packaging.js"
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "electron": ">=39.1.0 <40 || 46.0.0-alpha.2"
  }
}
