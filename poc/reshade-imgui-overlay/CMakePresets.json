{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/../../build/reshade-imgui-overlay",
      "architecture": "x64",
      "cacheVariables": {
        "RESHADE_BUILD_ELECTRON_CORE": "OFF"
      }
    },
    {
      "name": "vs2022-x64-electron-core",
      "displayName": "Visual Studio 2022 x64 with Electron core",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/../../build/reshade-imgui-overlay-electron-core",
      "cacheVariables": {
        "RESHADE_BUILD_ELECTRON_CORE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "configurePreset": "vs2022-x64",
      "configuration": "RelWithDebInfo",
      "targets": [
        "d3d11_overlay_test_host"
      ]
    },
    {
      "name": "relwithdebinfo-dx12",
      "displayName": "RelWithDebInfo D3D12 host",
      "configurePreset": "vs2022-x64",
      "configuration": "RelWithDebInfo",
      "targets": [
        "d3d12_overlay_test_host"
      ]
    },
    {
      "name": "relwithdebinfo-electron-core",
      "displayName": "RelWithDebInfo Electron core ABI smoke",
      "configurePreset": "vs2022-x64-electron-core",
      "configuration": "RelWithDebInfo",
      "targets": [
        "electron_core_abi_smoke",
        "electron_reshade_overlay_poc"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "electron-core",
      "displayName": "Electron core ABI smoke",
      "configurePreset": "vs2022-x64-electron-core",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
