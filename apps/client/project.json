{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "client",
  "projectType": "application",
  "sourceRoot": "apps/client/src",
  "implicitDependencies": ["electron-game-overlay"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/client",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/client",
        "command": "node --no-warnings --experimental-transform-types --test tests/*.test.mjs"
      }
    }
  }
}
