{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@apps/client",
  "projectType": "application",
  "sourceRoot": "apps/client/src",
  "targets": {
    "build-main": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/main"],
      "options": {
        "command": "vite build --config apps/client/vite.config.ts"
      }
    },
    "build-renderer": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/renderer"],
      "options": {
        "command": "vite build --config apps/client/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build --config apps/client/vite.config.ts"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/client/vite.config.ts"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "electron . --enable-logging"
      }
    }
  }
}
