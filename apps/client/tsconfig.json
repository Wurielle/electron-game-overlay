{
  "compilerOptions": {
    "target": "es2015",
    "module": "Node16",
    "lib": ["es2015", "es2016", "es2017", "dom", "es2018"],
    /* Specify library files to be included in the compilation. */
    // "jsx": "preserve",
    "allowJs": true,

    "sourceMap": true,
    "noEmit": true,
    "moduleResolution": "node16",
    "customConditions": ["gelectron"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules"],
  "references": [
    {
      "path": "../../libs/electron-game-overlay-sdk"
    }
  ]
}
