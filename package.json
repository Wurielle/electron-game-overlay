{
  "name": "gelectron",
  "version": "1.0.1",
  "main": "./apps/client/dist/main/main.js",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "libs/electron-game-overlay"
  ],
  "scripts": {
    "build": "nx run client:build",
    "dev": "nx run client:dev",
    "dev:gun-frog": "nx run client:dev --args=\"--mode=gun-frog\"",
    "typecheck": "nx run client:typecheck",
    "build:all": "nx run-many -t build --projects=electron-game-overlay,client",
    "demo:prepare": "nx run electron-game-overlay:build",
    "demo:basic-window": "node demos/scripts/run-demo.mjs basic-window",
    "demo:exact-process": "node demos/scripts/run-demo.mjs exact-process-attachment",
    "demo:input": "node demos/scripts/run-demo.mjs input-interception",
    "demo:multiple-windows": "node demos/scripts/run-demo.mjs multiple-windows",
    "demo:target-follow": "node demos/scripts/run-demo.mjs target-follow-and-telemetry",
    "demo:steam-auto-attach": "node demos/scripts/run-demo.mjs steam-auto-attach",
    "demo:smoke": "node demos/scripts/smoke-demos.mjs",
    "demo:typecheck": "tsc --project demos/tsconfig.json"
  },
  "devDependencies": {
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@swc/helpers": "^0.5.23",
    "@types/node": "^22.20.1",
    "electron": "39.8.10",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "electron-game-overlay": "file:libs/electron-game-overlay",
    "wql-process-monitor": "3.0.2"
  }
}
